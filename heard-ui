                               QLabel, QLineEdit, QMenu, QPlainTextEdit, QPushButton, QSizePolicy, QSpinBox,
                               QSystemTrayIcon, QTextBrowser, QVBoxLayout, QWidget)

IS_MAC = sys.platform == "darwin"
IS_WINDOWS = sys.platform == "win32"
MOD = "⌘⇧" if IS_MAC else "Ctrl+Shift+"

DATA_DIRECTORY = Path.home() / ".local/share/heard"
DATABASE_PATH = DATA_DIRECTORY / "heard.db"
PAUSE_FLAG = DATA_DIRECTORY / "paused"
LIVE_PATH = DATA_DIRECTORY / "live.json"
HEARTBEAT_PATH = DATA_DIRECTORY / "daemon.alive"
CONFIG_PATH = DATA_DIRECTORY / "ui-config.json"
CAPTURABLE = bool(os.environ.get("HEARD_UI_CAPTURABLE"))   # keep the window visible to screen capture (development)
BAR_WIDTH, BAR_HEIGHT, PANE_HEIGHT = 900, 46, 380

DEFAULT_SETTINGS = {
    "api_key": "",
    "user_name": (os.environ.get("USER") or os.environ.get("USERNAME") or "me").capitalize(),
    "playbook": "",
    "notes_folder": str(Path.home() / "Documents/heard"),
    "context_minutes": 15,
}


def load_settings():
    settings = dict(DEFAULT_SETTINGS)
    try:
        settings.update(json.loads(CONFIG_PATH.read_text()))
    except (OSError, ValueError):
        pass
    return settings


def save_settings(settings):
    DATA_DIRECTORY.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(settings, indent=2))
    os.chmod(CONFIG_PATH, 0o600)


def api_key(settings):
    return settings.get("api_key") or os.environ.get("ANTHROPIC_API_KEY", "")


# --- transcript -------------------------------------------------------------------------------------

class Transcript:
    def __init__(self):
        self.connection = None

    def _open(self):
        if self.connection is None and DATABASE_PATH.exists():
            self.connection = sqlite3.connect(f"file:{DATABASE_PATH}?mode=ro", uri=True, check_same_thread=False)
        return self.connection

    def since(self, when, limit=400):
        connection = self._open()
        if not connection:
            return []
        rows = connection.execute(
            "SELECT rowid, speaker, text, started_at FROM utterances WHERE CAST(started_at AS REAL) > ? "
            "ORDER BY CAST(started_at AS REAL) DESC LIMIT ?", (when, limit)).fetchall()
        return [(r[0], r[1], r[2], float(r[3])) for r in rows][::-1]

    def search(self, query, limit=200):
        connection = self._open()
        if not connection:
            return []
        try:
            rows = connection.execute(
                "SELECT rowid, speaker, text, started_at FROM utterances WHERE utterances MATCH ? "
                "ORDER BY CAST(started_at AS REAL) DESC LIMIT ?", (query, limit)).fetchall()
        except sqlite3.OperationalError:
            return []
        return [(r[0], r[1], r[2], float(r[3])) for r in rows][::-1]


def stamp(started_at):
    return time.strftime("%H:%M:%S", time.localtime(started_at))


# --- Claude (raw HTTP, streaming) --------------------------------------------------------------------

class ClaudeStream(QObject):
    text = Signal(str)
    failed = Signal(str)
    finished = Signal()

    def __init__(self, body, key):
        super().__init__()
        self.body, self.key = body, key
        self.cancelled = False

    def start(self):
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        request = urllib.request.Request(
            "https://api.anthropic.com/v1/messages", data=json.dumps(self.body).encode(),
            headers={"Content-Type": "application/json", "x-api-key": self.key,
                     "anthropic-version": "2023-06-01", "anthropic-beta": "server-side-fallback-2026-07-01"})
        try:
            with urllib.request.urlopen(request, timeout=120) as response:
                for raw in response:
                    if self.cancelled:
                        return
                    line = raw.decode("utf-8", "replace").rstrip("\n")
                    if not line.startswith("data: "):
                        continue
                    try:
                        event = json.loads(line[6:])
                    except ValueError:
                        continue
                    kind = event.get("type")
                    if kind == "content_block_delta" and event["delta"].get("type") == "text_delta":
                        self.text.emit(event["delta"]["text"])
                    elif kind == "message_delta" and event["delta"].get("stop_reason") == "refusal":
                        self.text.emit("\n\n(Claude declined to answer this one.)")
                    elif kind == "error":
                        self.failed.emit(event.get("error", {}).get("message", "stream error"))
                        return
        except urllib.error.HTTPError as error:
            detail = error.read().decode("utf-8", "replace")
            try:
                detail = json.loads(detail)["error"]["message"]
            except (ValueError, KeyError, TypeError):
                pass
            self.failed.emit(f"Claude API {error.code}: {detail}")
        except Exception as error:   # network errors, timeouts
            self.failed.emit(str(error))
        finally:
            self.finished.emit()


# --- state --------------------------------------------------------------------------------------------

class Store(QObject):
    changed = Signal()          # transcript / live / listening / daemon state
    answer_changed = Signal()
    status_changed = Signal(str)

    def __init__(self):
        super().__init__()
        self.transcript = Transcript()
        self.settings = load_settings()
        self.lines = []
        self.live = []
        self.listening = False
        self.listening_since = None
        self.daemon_running = False
        self.answer = ""
        self.answer_title = ""
        self.busy = False
        self.search_results = None
        self.newest = time.time() - 3 * 3600
        self.stream = None
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(500)
        self.refresh()

    def refresh(self):
        fresh = self.transcript.since(self.newest)
        if fresh:
            self.lines.extend(fresh)
            del self.lines[:-600]
            self.newest = fresh[-1][3]
        listening = not PAUSE_FLAG.exists()
        if listening and not self.listening:
            self.listening_since = time.time()
        self.listening = listening
        try:
            self.daemon_running = time.time() - HEARTBEAT_PATH.stat().st_mtime < 8
        except OSError:
            self.daemon_running = False
        live = []
        try:
            now = time.time()
            for speaker, entry in sorted(json.loads(LIVE_PATH.read_text()).items()):
                if now - entry["updated_at"] < 6:
                    live.append((speaker, entry["text"]))
        except (OSError, ValueError, KeyError):
            pass
        self.live = live
        self.changed.emit()

    def toggle_listening(self):
        if not self.daemon_running and not self.listening:
            self.status_changed.emit("heard-daemon is not running: install it first (macos/install.sh or windows/install.ps1)")
        DATA_DIRECTORY.mkdir(parents=True, exist_ok=True)
        if self.listening:
            PAUSE_FLAG.touch()
        else:
            PAUSE_FLAG.unlink(missing_ok=True)
        self.refresh()

    def search(self, query):
        query = query.strip()
        self.search_results = self.transcript.search(query) if query else None
        self.changed.emit()

    # AI
    def context_text(self):
        cutoff = time.time() - self.settings["context_minutes"] * 60
        recent = [line for line in self.lines if line[3] >= cutoff][-150:]
        if not recent:
            return f"(nothing has been said in the last {self.settings['context_minutes']} minutes)"
        return "\n".join(f"{stamp(started)} {speaker}: {text}" for _, speaker, text, started in recent)

    def system_prompt(self):
        name = self.settings["user_name"]
        prompt = (f"You sit quietly beside {name} during a live conversation and answer only to them. "
                  f"The transcript is from heard: \"them\" is the other party (or parties), \"me\" is {name}. "
                  "Transcription is automatic and imperfect, so read through small errors. "
                  "Your reply is read mid-conversation: be brief and concrete, two to four short bullets or sentences, "
                  "no preamble, no restating the transcript.")
        if self.settings["playbook"].strip():
            prompt += f"\n\nAbout {name} and what matters on their calls:\n{self.settings['playbook'].strip()}"
        return prompt

    def assist(self):
        name = self.settings["user_name"]
        self.ask("Assist", f"What should {name} say next? Give the two or three most useful things to say or ask "
                 "right now. If they were just asked a question, lead with a one-line answer to it.", "low")

    def recap(self):
        self.ask("Recap", "Summarize the conversation so far: key points, decisions, open questions, and action items "
                 "with owners. Use short Markdown bullets under those four headings; skip a heading that has nothing.",
                 "medium")

    def ask(self, title, prompt, effort="low"):
        key = api_key(self.settings)
        self.answer_title = title
        if not key:
            self.answer = "Add your Anthropic API key in Settings (the gear) to use Assist, Ask and Recap."
            self.answer_changed.emit()
            return
        if self.stream:
            self.stream.cancelled = True
        self.answer = ""
        self.busy = True
        self.answer_changed.emit()
        minutes = self.settings["context_minutes"]
        body = {
            "model": "claude-opus-5-5",
            "max_tokens": 2048,
            "stream": True,
            "fallbacks": "default",
            "output_config": {"effort": effort},
            "system": self.system_prompt(),
            "messages": [{"role": "user",
                          "content": f"Transcript of the last {minutes} minutes:\n\n{self.context_text()}\n\n{prompt}"}],
        }
        stream = ClaudeStream(body, key)
        stream.text.connect(self._on_text)
        stream.failed.connect(self._on_failed)
        stream.finished.connect(self._on_finished)
        self.stream = stream
        stream.start()

    def _on_text(self, text):
        self.answer += text
        self.answer_changed.emit()

    def _on_failed(self, message):
        self.answer += f"\n\n⚠️ {message}"
        self.answer_changed.emit()

    def _on_finished(self):
        self.busy = False
        self.answer_changed.emit()

    # notes
    def save_notes(self):
        folder = Path(self.settings["notes_folder"])
        folder.mkdir(parents=True, exist_ok=True)
        now = time.strftime("%Y-%m-%d %H.%M")
        path = folder / f"{now} heard.md"
        text = f"# heard notes, {now}\n\n"
        if self.answer:
            text += f"## {self.answer_title}\n\n{self.answer}\n\n"
        text += "## Transcript\n\n" + "\n".join(
            f"- {stamp(started)} **{speaker}**: {line}" for _, speaker, line, started in self.lines) + "\n"
        try:
            path.write_text(text)
            os.chmod(path, 0o600)
            self.status_changed.emit(f"Saved {path.name} in {folder}")
            reveal(path)
        except OSError as error:
            self.status_changed.emit(f"Could not save: {error}")


def reveal(path):
    if IS_MAC:
        subprocess.Popen(["open", "-R", str(path)])
    elif IS_WINDOWS:
        subprocess.Popen(["explorer", "/select,", str(path)])
    else:
        subprocess.Popen(["xdg-open", str(path.parent)])


def open_folder(path):
    Path(path).mkdir(parents=True, exist_ok=True)
    if IS_MAC:
        subprocess.Popen(["open", str(path)])
    elif IS_WINDOWS:
        os.startfile(str(path))   # noqa
    else:
        subprocess.Popen(["xdg-open", str(path)])


# --- global hotkeys (no permissions needed): Carbon on macOS, RegisterHotKey on Windows ----------------

class HotKeys:
    ASSIST, TOGGLE_VISIBLE, TOGGLE_LISTENING = 1, 2, 3

    def __init__(self, app, callback):
        self.callback = callback
        self._keep = []
        try:
            if IS_MAC:
                self._mac()
            elif IS_WINDOWS:
                self._windows(app)
        except Exception as error:   # hotkeys are a convenience; the UI works without them
            print("heard-ui: global hotkeys unavailable:", error, file=sys.stderr)

    def _mac(self):
        carbon = ctypes.CDLL("/System/Library/Frameworks/Carbon.framework/Carbon")

        class EventHotKeyID(ctypes.Structure):
            _fields_ = [("signature", ctypes.c_uint32), ("id", ctypes.c_uint32)]

        class EventTypeSpec(ctypes.Structure):
            _fields_ = [("eventClass", ctypes.c_uint32), ("eventKind", ctypes.c_uint32)]

        handler_type = ctypes.CFUNCTYPE(ctypes.c_int32, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p)
        carbon.GetApplicationEventTarget.restype = ctypes.c_void_p
        carbon.InstallEventHandler.argtypes = [ctypes.c_void_p, handler_type, ctypes.c_uint32,
                                               ctypes.POINTER(EventTypeSpec), ctypes.c_void_p, ctypes.c_void_p]
        carbon.RegisterEventHotKey.argtypes = [ctypes.c_uint32, ctypes.c_uint32, EventHotKeyID, ctypes.c_void_p,
                                               ctypes.c_uint32, ctypes.POINTER(ctypes.c_void_p)]
        carbon.GetEventParameter.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_void_p,
                                             ctypes.c_uint32, ctypes.c_void_p, ctypes.c_void_p]

        def handler(_next, event, _data):
            hot_key = EventHotKeyID()
            carbon.GetEventParameter(event, 0x2D2D2D2D, 0x686B6964, None, ctypes.sizeof(hot_key), None,
                                     ctypes.byref(hot_key))   # '----', 'hkid'
            self.callback(hot_key.id)
            return 0

        handler_c = handler_type(handler)
        target = carbon.GetApplicationEventTarget()
        spec = EventTypeSpec(0x6B657962, 5)   # 'keyb', kEventHotKeyPressed
        carbon.InstallEventHandler(target, handler_c, 1, ctypes.byref(spec), None, None)
        self._keep += [handler_c, spec]
        command_shift = (1 << 8) | (1 << 9)
        for key_id, key_code in ((self.ASSIST, 36), (self.TOGGLE_VISIBLE, 4), (self.TOGGLE_LISTENING, 37)):   # ↩ H L
            ref = ctypes.c_void_p()
            carbon.RegisterEventHotKey(key_code, command_shift, EventHotKeyID(0x48454152, key_id), target, 0,
                                       ctypes.byref(ref))
            self._keep.append(ref)

    def _windows(self, app):
        user32 = ctypes.windll.user32
        mod_control_shift = 0x0002 | 0x0004
        for key_id, virtual_key in ((self.ASSIST, 0x0D), (self.TOGGLE_VISIBLE, 0x48), (self.TOGGLE_LISTENING, 0x4C)):
            user32.RegisterHotKey(None, key_id, mod_control_shift | 0x4000, virtual_key)   # MOD_NOREPEAT

        callback = self.callback

        class Filter(QAbstractNativeEventFilter):
            def nativeEventFilter(self, event_type, message):
                msg = ctypes.wintypes.MSG.from_address(int(message))
                if msg.message == 0x0312:   # WM_HOTKEY
                    callback(int(msg.wParam))
                return False, 0

        import ctypes.wintypes  # noqa: F401  (needed for MSG)
        self._filter = Filter()
        app.installNativeEventFilter(self._filter)


