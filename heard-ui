def pill(text, slot, name=None, tooltip=None):
    button = QPushButton(text)
    button.setCursor(Qt.PointingHandCursor)
    button.setFocusPolicy(Qt.NoFocus)
    if name:
        button.setObjectName(name)
    if tooltip:
        button.setToolTip(tooltip)
    button.clicked.connect(slot)
    return button


def repolish(widget):
    widget.style().unpolish(widget)
    widget.style().polish(widget)


class LivePane(QWidget):
    def __init__(self, store):
        super().__init__()
        self.store = store
        self.view = QTextBrowser()
        self.view.setOpenLinks(False)
        self.copy_button = pill("Copy transcript", store.copy_transcript, tooltip="Copy everything shown, as text")
        tools = QHBoxLayout()
        tools.setContentsMargins(0, 0, 0, 0)
        tools.addWidget(self.copy_button)
        tools.addStretch(1)
        layout = QVBoxLayout()
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(6)
        layout.addWidget(self.view, 1)
        layout.addLayout(tools)
        self.setLayout(layout)
        self._last_html = None
        # Follow the newest line unless the reader scrolled up; scrolling back to the bottom follows again.
        # setHtml() resets the scroll bar and the new length is only known after layout, so the position is
        # (re)applied whenever the range changes, not just right after setHtml().
        self.follow = True
        self.position = 0          # where the reader left the scroll bar while not following
        self.updating = False      # True while we move the scroll bar ourselves
        self._searching = False
        bar = self.view.verticalScrollBar()
        bar.valueChanged.connect(self.on_scroll)
        bar.rangeChanged.connect(self.on_range)
        store.changed.connect(self.render)

    def on_scroll(self, value):
        if self.updating:
            return
        bar = self.view.verticalScrollBar()
        self.follow = value >= bar.maximum() - 4
        self.position = value

    def on_range(self, _minimum, maximum):
        was_updating = self.updating   # this also fires from inside setHtml(): keep render()'s guard up
        self.updating = True
        self.view.verticalScrollBar().setValue(maximum if self.follow else min(self.position, maximum))
        self.updating = was_updating

    def render(self):
        store = self.store
        shown = store.shown_lines()
        self.copy_button.setVisible(bool(shown) and (store.session_start is not None or store.search_results is not None))
        parts = []
        if not shown:
            if store.search_results is not None:
                parts.append('<p style="color:#8a8a8a">No matches.</p>')
            elif store.listening:
                parts.append('<p style="color:#8a8a8a">Listening. Lines appear a few seconds after someone speaks.</p>')
            else:
                parts.append('<p style="color:#8a8a8a">Not listening. Start listening before a call, Pause any time; '
                             'Stop recording files the call in the Library and clears this view.</p>')
        for _, speaker, text, started in shown:
            color = "#5aa0ff" if speaker == "me" else "#f0a44a"
            parts.append(f'<div style="margin:0 0 3px 0"><span style="color:#6f6f6f;font-family:Menlo,Consolas,monospace;'
                         f'font-size:10px">{stamp(started)}</span>&nbsp; <b style="color:{color}">{speaker}</b>&nbsp; '
                         f'{escape(text)}</div>')
        if store.search_results is None:
            for speaker, text in store.live:
                parts.append(f'<div style="color:#8a8a8a;margin:0 0 3px 0"><i>… {speaker}: {escape(text)}</i></div>')
        bar = self.view.verticalScrollBar()
        html = "".join(parts)
        searching = store.search_results is not None
        if searching != self._searching:   # entering or leaving search: start at the newest line
            self._searching = searching
            self.follow = True
        if html != self._last_html:
            self._last_html = html
            self.updating = True
            self.view.setHtml(html)
            bar.setValue(bar.maximum() if self.follow else min(self.position, bar.maximum()))
            self.updating = False


class LogsPane(QWidget):
    def __init__(self, store):
        super().__init__()
        self.store = store
        self.list = QListWidget()
        self.list.setFixedWidth(250)
        self.list.setFocusPolicy(Qt.NoFocus)
        self.list.setWordWrap(True)
        self.list.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.list.currentItemChanged.connect(lambda current, _previous: self.show_log(current))
        self.view = QTextBrowser()
        self.view.setOpenExternalLinks(True)
        self.copy_button = pill("Copy log", self.copy_log, tooltip="Copy this log as text")
        self.reveal_button = pill("Show in folder", self.reveal_log)
        self.summarize_button = pill("Summarize", self.summarize_current,
                                     tooltip="Name this meeting and add a summary, key points and action items")
        self.delete_button = pill("Delete", self.delete_log, tooltip="Move this log to the Trash / delete it")
        self.delete_button.setIcon(self.style().standardIcon(QStyle.StandardPixmap.SP_TrashIcon))
        tools = QHBoxLayout()
        tools.setContentsMargins(0, 0, 0, 0)
        tools.addWidget(self.copy_button)
        tools.addWidget(self.reveal_button)
        tools.addWidget(self.summarize_button)
        tools.addStretch(1)
        tools.addWidget(self.delete_button)
        right = QVBoxLayout()
        right.setContentsMargins(0, 0, 0, 0)
        right.setSpacing(6)
        right.addWidget(self.view, 1)
        right.addLayout(tools)
        layout = QHBoxLayout()
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(12)
        layout.addWidget(self.list)
        layout.addLayout(right, 1)
        self.setLayout(layout)
        store.logs_changed.connect(self.reload)
        self.reload()

    def reload(self):
        current = self.store.last_log_path or self.current_path()   # a just-written log wins over the old selection
        self.store.last_log_path = None
        self.list.clear()
        for path in self.store.logs():
            name = path.name[:-len(LOG_SUFFIX)]
            item = QListWidgetItem(f"{name[:16]}\n{name[17:]}" if len(name) > 17 else name)   # date/time, then title
            item.setData(Qt.UserRole, str(path))
            item.setToolTip(str(path))
            self.list.addItem(item)
        if self.list.count() == 0:
            self.view.setHtml('<p style="color:#8a8a8a">Nothing in the library yet. Stop recording files the current call here.</p>')
            return
        for index in range(self.list.count()):
            if current and self.list.item(index).data(Qt.UserRole) == current:
                self.list.setCurrentRow(index)
                return
        self.list.setCurrentRow(0)

    def current_path(self):
        item = self.list.currentItem()
        return item.data(Qt.UserRole) if item else None

    def show_log(self, item):
        if not item:
            return
        try:
            text = Path(item.data(Qt.UserRole)).read_text(encoding="utf-8")
            if text.startswith("# "):
                text = "#### " + text[2:]   # the title line, at a size that fits the pane
            text = re.sub(r"(?m)^## ", "##### ", text)   # Summary / Key points / ... below the title
            self.view.setMarkdown(text)
        except OSError as error:
            self.view.setPlainText(f"Could not read the log: {error}")

    def copy_log(self):
        path = self.current_path()
        if path:
            QApplication.clipboard().setText(Path(path).read_text(encoding="utf-8"))
            self.store.status_changed.emit(f"Copied {Path(path).name} to the clipboard")

    def reveal_log(self):
        path = self.current_path()
        if path:
            reveal(Path(path))

    def summarize_current(self):
        path = self.current_path()
        if path:
            self.store.summarize_log(path)

    def delete_log(self):
        path = self.current_path()
        if not path:
            return
        try:
            if IS_MAC:
                subprocess.run(["osascript", "-e", f'tell application "Finder" to delete POSIX file "{path}"'],
                               capture_output=True, timeout=10)
                if Path(path).exists():
                    Path(path).unlink()
            else:
                Path(path).unlink()
            self.store.status_changed.emit(f"Deleted {Path(path).name}")
        except (OSError, subprocess.SubprocessError) as error:
            self.store.status_changed.emit(f"Could not delete: {error}")
        self.reload()


