#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "PySide6>=6.7",
#   "pyobjc-framework-Cocoa>=10; sys_platform == 'darwin'",
# ]
# ///
"""heard-ui: a light overlay for heard. macOS, Windows, Linux (one Qt script).

A translucent, always-on-top bar that is excluded from screen sharing, with:
  - the Listening / Paused switch (capture happens only while this is on)
  - the live transcript (lines land a few seconds after someone speaks; the sentence in progress is dimmed)
  - search over the retained history
  - Save: the transcript as a Markdown file in your notes folder
  - a tray / menu bar icon that shows whether capture is on

Global hotkeys: ⌘⇧H show/hide, ⌘⇧L listening on/off (Ctrl+Shift on Windows). None on Linux.
Everything reads ~/.local/share/heard (heard.db, live.json, paused, daemon.alive); nothing leaves the machine.
"""
import ctypes
import json
import os
import sqlite3
import subprocess
import sys
import time
from pathlib import Path

from PySide6.QtCore import QAbstractNativeEventFilter, QObject, QPoint, QRectF, Qt, QTimer, Signal
from PySide6.QtGui import QAction, QColor, QIcon, QKeySequence, QPainter, QPixmap, QShortcut
from PySide6.QtWidgets import (QApplication, QDialog, QDialogButtonBox, QFileDialog, QFormLayout, QHBoxLayout,
                               QLabel, QLineEdit, QMenu, QPushButton, QSizePolicy, QSystemTrayIcon, QTextBrowser,
                               QVBoxLayout, QWidget)

IS_MAC = sys.platform == "darwin"
IS_WINDOWS = sys.platform == "win32"
MOD = "⌘⇧" if IS_MAC else "Ctrl+Shift+"

DATA_DIRECTORY = Path.home() / ".local/share/heard"
DATABASE_PATH = DATA_DIRECTORY / "heard.db"
PAUSE_FLAG = DATA_DIRECTORY / "paused"
LIVE_PATH = DATA_DIRECTORY / "live.json"
HEARTBEAT_PATH = DATA_DIRECTORY / "daemon.alive"
CONFIG_PATH = DATA_DIRECTORY / "ui-config.json"
CAPTURABLE = bool(os.environ.get("HEARD_UI_CAPTURABLE"))   # keep the window visible to screen capture (development)
BAR_WIDTH, BAR_HEIGHT, PANE_HEIGHT = 760, 46, 360

DEFAULT_SETTINGS = {"notes_folder": str(Path.home() / "Documents/heard")}


def load_settings():
    settings = dict(DEFAULT_SETTINGS)
    try:
        settings.update({k: v for k, v in json.loads(CONFIG_PATH.read_text()).items() if k in DEFAULT_SETTINGS})
    except (OSError, ValueError):
        pass
    return settings


def save_settings(settings):
    DATA_DIRECTORY.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(settings, indent=2))
    os.chmod(CONFIG_PATH, 0o600)


# --- transcript -------------------------------------------------------------------------------------

class Transcript:
    def __init__(self):
        self.connection = None

    def _open(self):
        if self.connection is None and DATABASE_PATH.exists():
            self.connection = sqlite3.connect(f"file:{DATABASE_PATH}?mode=ro", uri=True, check_same_thread=False)
        return self.connection

    def since(self, when, limit=400):
        connection = self._open()
        if not connection:
            return []
        rows = connection.execute(
            "SELECT rowid, speaker, text, started_at FROM utterances WHERE CAST(started_at AS REAL) > ? "
            "ORDER BY CAST(started_at AS REAL) DESC LIMIT ?", (when, limit)).fetchall()
        return [(r[0], r[1], r[2], float(r[3])) for r in rows][::-1]

    def search(self, query, limit=200):
        connection = self._open()
        if not connection:
            return []
        try:
            rows = connection.execute(
                "SELECT rowid, speaker, text, started_at FROM utterances WHERE utterances MATCH ? "
                "ORDER BY CAST(started_at AS REAL) DESC LIMIT ?", (query, limit)).fetchall()
        except sqlite3.OperationalError:
            return []
        return [(r[0], r[1], r[2], float(r[3])) for r in rows][::-1]


def stamp(started_at):
    return time.strftime("%H:%M:%S", time.localtime(started_at))


# --- state --------------------------------------------------------------------------------------------

class Store(QObject):
    changed = Signal()          # transcript / live / listening / daemon state
    status_changed = Signal(str)

    def __init__(self):
        super().__init__()
        self.transcript = Transcript()
        self.settings = load_settings()
        self.lines = []
        self.live = []
        self.listening = False
        self.listening_since = None
        self.daemon_running = False
        self.search_results = None
        self.newest = time.time() - 3 * 3600
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(500)
        self.refresh()

    def refresh(self):
        fresh = self.transcript.since(self.newest)
        if fresh:
            self.lines.extend(fresh)
            del self.lines[:-600]
            self.newest = fresh[-1][3]
        listening = not PAUSE_FLAG.exists()
        if listening and not self.listening:
            self.listening_since = time.time()
        self.listening = listening
        try:
            self.daemon_running = time.time() - HEARTBEAT_PATH.stat().st_mtime < 8
        except OSError:
            self.daemon_running = False
        live = []
        try:
            now = time.time()
            for speaker, entry in sorted(json.loads(LIVE_PATH.read_text()).items()):
                if now - entry["updated_at"] < 6:
                    live.append((speaker, entry["text"]))
        except (OSError, ValueError, KeyError):
            pass
        self.live = live
        self.changed.emit()

    def toggle_listening(self):
        if not self.daemon_running and not self.listening:
            self.status_changed.emit("heard-daemon is not running: install it first (macos/install.sh or windows/install.ps1)")
        DATA_DIRECTORY.mkdir(parents=True, exist_ok=True)
        if self.listening:
            PAUSE_FLAG.touch()
        else:
            PAUSE_FLAG.unlink(missing_ok=True)
        self.refresh()

    def search(self, query):
        query = query.strip()
        self.search_results = self.transcript.search(query) if query else None
        self.changed.emit()

    def save_notes(self):
        folder = Path(self.settings["notes_folder"])
        folder.mkdir(parents=True, exist_ok=True)
        now = time.strftime("%Y-%m-%d %H.%M")
        path = folder / f"{now} heard.md"
        shown = self.search_results if self.search_results is not None else self.lines
        text = f"# heard transcript, {now}\n\n" + "\n".join(
            f"- {stamp(started)} **{speaker}**: {line}" for _, speaker, line, started in shown) + "\n"
        try:
            path.write_text(text)
            os.chmod(path, 0o600)
            self.status_changed.emit(f"Saved {path.name} in {folder}")
            reveal(path)
        except OSError as error:
            self.status_changed.emit(f"Could not save: {error}")


def reveal(path):
    if IS_MAC:
        subprocess.Popen(["open", "-R", str(path)])
    elif IS_WINDOWS:
        subprocess.Popen(["explorer", "/select,", str(path)])
    else:
        subprocess.Popen(["xdg-open", str(path.parent)])


def open_folder(path):
    Path(path).mkdir(parents=True, exist_ok=True)
    if IS_MAC:
        subprocess.Popen(["open", str(path)])
    elif IS_WINDOWS:
        os.startfile(str(path))   # noqa
    else:
        subprocess.Popen(["xdg-open", str(path)])


# --- global hotkeys (no permissions needed): Carbon on macOS, RegisterHotKey on Windows ----------------

class HotKeys:
    TOGGLE_VISIBLE, TOGGLE_LISTENING = 1, 2

    def __init__(self, app, callback):
        self.callback = callback
        self._keep = []
        try:
            if IS_MAC:
                self._mac()
            elif IS_WINDOWS:
                self._windows(app)
        except Exception as error:   # hotkeys are a convenience; the UI works without them
            print("heard-ui: global hotkeys unavailable:", error, file=sys.stderr)

    def _mac(self):
        carbon = ctypes.CDLL("/System/Library/Frameworks/Carbon.framework/Carbon")

        class EventHotKeyID(ctypes.Structure):
            _fields_ = [("signature", ctypes.c_uint32), ("id", ctypes.c_uint32)]

        class EventTypeSpec(ctypes.Structure):
            _fields_ = [("eventClass", ctypes.c_uint32), ("eventKind", ctypes.c_uint32)]

        handler_type = ctypes.CFUNCTYPE(ctypes.c_int32, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p)
        carbon.GetApplicationEventTarget.restype = ctypes.c_void_p
        carbon.InstallEventHandler.argtypes = [ctypes.c_void_p, handler_type, ctypes.c_uint32,
                                               ctypes.POINTER(EventTypeSpec), ctypes.c_void_p, ctypes.c_void_p]
        carbon.RegisterEventHotKey.argtypes = [ctypes.c_uint32, ctypes.c_uint32, EventHotKeyID, ctypes.c_void_p,
                                               ctypes.c_uint32, ctypes.POINTER(ctypes.c_void_p)]
        carbon.GetEventParameter.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_void_p,
                                             ctypes.c_uint32, ctypes.c_void_p, ctypes.c_void_p]

        def handler(_next, event, _data):
            hot_key = EventHotKeyID()
            carbon.GetEventParameter(event, 0x2D2D2D2D, 0x686B6964, None, ctypes.sizeof(hot_key), None,
                                     ctypes.byref(hot_key))   # '----', 'hkid'
            self.callback(hot_key.id)
            return 0

        handler_c = handler_type(handler)
        target = carbon.GetApplicationEventTarget()
        spec = EventTypeSpec(0x6B657962, 5)   # 'keyb', kEventHotKeyPressed
        carbon.InstallEventHandler(target, handler_c, 1, ctypes.byref(spec), None, None)
        self._keep += [handler_c, spec]
        command_shift = (1 << 8) | (1 << 9)
        for key_id, key_code in ((self.TOGGLE_VISIBLE, 4), (self.TOGGLE_LISTENING, 37)):   # H, L
            ref = ctypes.c_void_p()
            carbon.RegisterEventHotKey(key_code, command_shift, EventHotKeyID(0x48454152, key_id), target, 0,
                                       ctypes.byref(ref))
            self._keep.append(ref)

    def _windows(self, app):
        import ctypes.wintypes
        user32 = ctypes.windll.user32
        mod_control_shift = 0x0002 | 0x0004
        for key_id, virtual_key in ((self.TOGGLE_VISIBLE, 0x48), (self.TOGGLE_LISTENING, 0x4C)):   # H, L
            user32.RegisterHotKey(None, key_id, mod_control_shift | 0x4000, virtual_key)   # MOD_NOREPEAT

        callback = self.callback

        class Filter(QAbstractNativeEventFilter):
            def nativeEventFilter(self, event_type, message):
                msg = ctypes.wintypes.MSG.from_address(int(message))
                if msg.message == 0x0312:   # WM_HOTKEY
                    callback(int(msg.wParam))
                return False, 0

        self._filter = Filter()
        app.installNativeEventFilter(self._filter)


# --- views ---------------------------------------------------------------------------------------------

STYLE = """
QWidget { color: #ececec; font-size: 12px; }
QPushButton { background: rgba(255,255,255,0.09); border: none; border-radius: 13px; padding: 5px 11px; }
QPushButton:hover { background: rgba(255,255,255,0.17); }
QPushButton#icon { background: transparent; color: #9c9c9c; padding: 4px 6px; font-size: 13px; }
QPushButton#icon:hover { color: #ffffff; }
QLineEdit { background: rgba(255,255,255,0.09); border: none; border-radius: 13px; padding: 5px 11px; }
QTextBrowser { background: transparent; border: none; }
QLabel#status { color: #9c9c9c; font-size: 10px; }
QScrollBar:vertical { background: transparent; width: 8px; }
QScrollBar::handle:vertical { background: rgba(255,255,255,0.18); border-radius: 4px; min-height: 20px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
"""


def pill(text, slot, name=None, tooltip=None):
    button = QPushButton(text)
    button.setCursor(Qt.PointingHandCursor)
    button.setFocusPolicy(Qt.NoFocus)
    if name:
        button.setObjectName(name)
    if tooltip:
        button.setToolTip(tooltip)
    button.clicked.connect(slot)
    return button


class Overlay(QWidget):
    def __init__(self, store, hide_me, open_settings):
        super().__init__(None, Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        self.store = store
        self.setAttribute(Qt.WA_TranslucentBackground)
        if IS_MAC:
            self.setAttribute(Qt.WA_MacAlwaysShowToolWindow)
        self.setStyleSheet(STYLE)
        self.expanded = True
        self.drag_offset = None

        self.listen_button = pill("", store.toggle_listening, tooltip=f"Start / stop capturing ({MOD}L)")
        self.search = QLineEdit()
        self.search.setPlaceholderText("Search the retained history…  (Enter; clear to go back live)")
        self.search.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.search.returnPressed.connect(lambda: store.search(self.search.text()))
        self.search.textChanged.connect(lambda text: store.search("") if not text else None)
        self.save_button = pill("Save", store.save_notes, tooltip="Save what is shown as a Markdown file")
        self.expand_button = pill("⌃", self.toggle_expanded, "icon", "Collapse / expand")
        self.settings_button = pill("⚙", open_settings, "icon", "Settings")
        self.hide_button = pill("✕", hide_me, "icon", f"Hide ({MOD}H)")

        bar = QHBoxLayout()
        bar.setContentsMargins(12, 0, 8, 0)
        bar.setSpacing(8)
        for widget in (self.listen_button, self.search, self.save_button, self.expand_button,
                       self.settings_button, self.hide_button):
            bar.addWidget(widget)
        bar_widget = QWidget()
        bar_widget.setLayout(bar)
        bar_widget.setFixedHeight(BAR_HEIGHT)

        self.transcript_view = QTextBrowser()
        self.transcript_view.setOpenLinks(False)
        self.status = QLabel("")
        self.status.setObjectName("status")
        self.status.setContentsMargins(14, 0, 14, 6)
        self.pane = QWidget()
        pane_layout = QVBoxLayout()
        pane_layout.setContentsMargins(12, 6, 12, 0)
        pane_layout.setSpacing(0)
        pane_layout.addWidget(self.transcript_view, 1)
        pane_layout.addWidget(self.status)
        self.pane.setLayout(pane_layout)

        root = QVBoxLayout()
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)
        root.addWidget(bar_widget)
        root.addWidget(self.pane, 1)
        self.setLayout(root)

        QShortcut(QKeySequence(Qt.Key_Escape), self, activated=hide_me)
        store.changed.connect(self.render_state)
        store.status_changed.connect(self.status.setText)
        self.render_state()
        self.apply_size()

    # window chrome
    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        rect = QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        painter.setBrush(QColor(20, 20, 25, 232))
        painter.setPen(QColor(255, 255, 255, 36))
        painter.drawRoundedRect(rect, 15, 15)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.drag_offset = event.globalPosition().toPoint() - self.frameGeometry().topLeft()

    def mouseMoveEvent(self, event):
        if self.drag_offset is not None and event.buttons() & Qt.LeftButton:
            self.move(event.globalPosition().toPoint() - self.drag_offset)

    def mouseReleaseEvent(self, _event):
        self.drag_offset = None

    def toggle_expanded(self):
        self.expanded = not self.expanded
        self.apply_size()

    def apply_size(self):
        self.pane.setVisible(self.expanded)
        self.expand_button.setText("⌃" if self.expanded else "⌄")
        self.setFixedSize(BAR_WIDTH, BAR_HEIGHT + (PANE_HEIGHT if self.expanded else 0))

    def place_at_top(self):
        screen = QApplication.primaryScreen().availableGeometry()
        self.move(QPoint(screen.center().x() - BAR_WIDTH // 2, screen.top() + 10))

    # rendering
    def render_state(self):
        store = self.store
        if not store.daemon_running:
            label, color = "Daemon off", "#777"
        elif store.listening:
            minutes = int((time.time() - (store.listening_since or time.time())) / 60)
            label, color = f"Listening · {minutes} min" if minutes else "Listening", "#ff3b30"
        else:
            label, color = "Paused", "#8a8a8a"
        self.listen_button.setText(f"●  {label}   {MOD}L")
        self.listen_button.setStyleSheet(f"color: {color}; font-weight: 600;" if store.listening else "")

        shown = store.search_results if store.search_results is not None else store.lines
        parts = []
        if not shown:
            if store.search_results is not None:
                parts.append('<p style="color:#8a8a8a">No matches.</p>')
            elif store.listening:
                parts.append('<p style="color:#8a8a8a">Listening. Lines appear a few seconds after someone speaks.</p>')
            else:
                parts.append('<p style="color:#8a8a8a">Paused. Nothing is captured until you turn Listening on.</p>')
        for _, speaker, text, started in shown:
            color = "#5aa0ff" if speaker == "me" else "#f0a44a"
            parts.append(f'<div style="margin:0 0 3px 0"><span style="color:#6f6f6f;font-family:Menlo,Consolas,monospace;'
                         f'font-size:10px">{stamp(started)}</span>&nbsp; <b style="color:{color}">{speaker}</b>&nbsp; '
                         f'{escape(text)}</div>')
        if store.search_results is None:
            for speaker, text in store.live:
                parts.append(f'<div style="color:#8a8a8a;margin:0 0 3px 0"><i>… {speaker}: {escape(text)}</i></div>')
        bar = self.transcript_view.verticalScrollBar()
        at_bottom = bar.value() >= bar.maximum() - 4
        html = "".join(parts)
        if html != getattr(self, "_last_html", None):
            self._last_html = html
            self.transcript_view.setHtml(html)
            if at_bottom or store.search_results is not None:
                bar.setValue(bar.maximum())


def escape(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


class SettingsDialog(QDialog):
    def __init__(self, store, parent=None):
        super().__init__(parent)
        self.store = store
        self.setWindowTitle("Heard settings")
        self.setWindowFlag(Qt.WindowStaysOnTopHint, True)
        self.folder = QLineEdit(store.settings["notes_folder"])
        browse = QPushButton("Choose…")
        browse.clicked.connect(self.choose_folder)
        folder_row = QHBoxLayout()
        folder_row.addWidget(self.folder)
        folder_row.addWidget(browse)
        form = QFormLayout()
        form.addRow("Notes folder (Save writes here)", folder_row)
        note = QLabel(f"The transcript itself lives in {DATA_DIRECTORY}, readable only by you, and is deleted "
                      "after a few days. Nothing leaves the machine.")
        note.setWordWrap(True)
        note.setStyleSheet("color: #888; font-size: 11px;")
        form.addRow("", note)
        buttons = QDialogButtonBox(QDialogButtonBox.Save | QDialogButtonBox.Cancel)
        buttons.accepted.connect(self.save)
        buttons.rejected.connect(self.reject)
        layout = QVBoxLayout()
        layout.addLayout(form)
        layout.addWidget(buttons)
        self.setLayout(layout)
        self.resize(480, 150)

    def choose_folder(self):
        chosen = QFileDialog.getExistingDirectory(self, "Notes folder", self.folder.text())
        if chosen:
            self.folder.setText(chosen)

    def save(self):
        self.store.settings["notes_folder"] = self.folder.text().strip() or DEFAULT_SETTINGS["notes_folder"]
        save_settings(self.store.settings)
        self.accept()


def tray_icon(listening):
    pixmap = QPixmap(44, 44)
    pixmap.fill(Qt.transparent)
    painter = QPainter(pixmap)
    painter.setRenderHint(QPainter.Antialiasing)
    painter.setPen(Qt.NoPen)
    painter.setBrush(QColor("#ff3b30") if listening else QColor(140, 140, 140))
    painter.drawEllipse(6, 6, 32, 32)
    painter.setBrush(QColor(255, 255, 255, 230))
    for i, h in enumerate((6, 12, 20, 12, 6)):   # a small waveform glyph
        painter.drawRoundedRect(12 + i * 5, 22 - h // 2, 3, h, 1.5, 1.5)
    painter.end()
    return QIcon(pixmap)


# --- platform glue -----------------------------------------------------------------------------------

def platform_setup(widget):
    """After the window exists: keep it off screen shares, floating over everything, without a Dock icon."""
    if IS_MAC:
        try:
            import objc
            from AppKit import NSApp
            NSApp.setActivationPolicy_(1)   # accessory: no Dock icon, no menu bar takeover
            window = objc.objc_object(c_void_p=int(widget.winId())).window()
            window.setSharingType_(1 if CAPTURABLE else 0)   # NSWindowSharingNone: invisible to screen sharing/recording
            window.setLevel_(3)                               # NSFloatingWindowLevel
            window.setCollectionBehavior_((1 << 0) | (1 << 8))   # all Spaces, over full-screen apps
            window.setHidesOnDeactivate_(False)
            window.setStyleMask_(window.styleMask() | (1 << 7))   # non-activating panel: clicks don't switch apps
        except Exception as error:
            print("heard-ui: macOS window setup incomplete:", error, file=sys.stderr)
    elif IS_WINDOWS and not CAPTURABLE:
        try:
            ctypes.windll.user32.SetWindowDisplayAffinity(int(widget.winId()), 0x11)   # WDA_EXCLUDEFROMCAPTURE
        except Exception as error:
            print("heard-ui: could not exclude the window from capture:", error, file=sys.stderr)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Heard")
    app.setQuitOnLastWindowClosed(False)
    store = Store()

    def toggle_visible():
        if overlay.isVisible():
            overlay.hide()
        else:
            overlay.show()
            overlay.raise_()

    def open_settings():
        if IS_MAC:
            from AppKit import NSApp
            NSApp.activateIgnoringOtherApps_(True)
        SettingsDialog(store).exec()

    overlay = Overlay(store, hide_me=lambda: overlay.hide(), open_settings=open_settings)
    overlay.place_at_top()
    overlay.show()
    platform_setup(overlay)

    tray = QSystemTrayIcon(tray_icon(store.listening))
    menu = QMenu()
    menu.addAction(QAction(f"Show / hide overlay\t{MOD}H", menu, triggered=toggle_visible))
    menu.addAction(QAction(f"Listening on / off\t{MOD}L", menu, triggered=store.toggle_listening))
    menu.addSeparator()
    menu.addAction(QAction("Open notes folder", menu, triggered=lambda: open_folder(store.settings["notes_folder"])))
    menu.addAction(QAction("Open transcript folder", menu, triggered=lambda: open_folder(DATA_DIRECTORY)))
    menu.addAction(QAction("Settings…", menu, triggered=open_settings))
    menu.addSeparator()
    menu.addAction(QAction("Quit Heard", menu, triggered=app.quit))
    tray.setContextMenu(menu)
    tray.setToolTip("heard")
    tray.show()
    store.changed.connect(lambda: tray.setIcon(tray_icon(store.listening)))

    def on_hotkey(key_id):
        if key_id == HotKeys.TOGGLE_VISIBLE:
            toggle_visible()
        elif key_id == HotKeys.TOGGLE_LISTENING:
            store.toggle_listening()
    hotkeys = HotKeys(app, on_hotkey)   # noqa: F841  (kept alive)

    if os.environ.get("HEARD_UI_SCREENSHOT"):   # development: grab the window and exit
        def shoot():
            overlay.grab().save(os.environ["HEARD_UI_SCREENSHOT"])
            app.quit()
        QTimer.singleShot(int(os.environ.get("HEARD_UI_SCREENSHOT_DELAY", "3000")), shoot)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
