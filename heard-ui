def load_settings():
    settings = dict(DEFAULT_SETTINGS)
    try:
        settings.update({k: v for k, v in json.loads(CONFIG_PATH.read_text(encoding="utf-8")).items() if k in DEFAULT_SETTINGS})
    except (OSError, ValueError):
        pass
    return settings


def save_settings(settings):
    DATA_DIRECTORY.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(settings, indent=2), encoding="utf-8")
    os.chmod(CONFIG_PATH, 0o600)


# --- transcript -------------------------------------------------------------------------------------

class Transcript:
    def __init__(self):
        self.connection = None

    def _open(self):
        if self.connection is None and DATABASE_PATH.exists():
            self.connection = sqlite3.connect(DATABASE_PATH.as_uri() + "?mode=ro", uri=True, check_same_thread=False)
        return self.connection

    def since(self, when, limit=400):
        connection = self._open()
        if not connection:
            return []
        rows = connection.execute(
            "SELECT rowid, speaker, text, started_at FROM utterances WHERE CAST(started_at AS REAL) > ? "
            "ORDER BY CAST(started_at AS REAL) DESC LIMIT ?", (when, limit)).fetchall()
        return [(r[0], r[1], r[2], float(r[3])) for r in rows][::-1]

    def search(self, query, limit=200):
        """Live search: plain words match as prefixes ("rene" finds "renewal"); anything with quotes or
        FTS5 operators is passed through as typed."""
        connection = self._open()
        if not connection:
            return []
        if not any(token in query for token in ('"', " OR ", " NOT ", "*", "(")):
            words = re.findall(r"[\w']+", query)
            if not words:
                return []
            query = " ".join(f'"{word}"*' for word in words)
        try:
            rows = connection.execute(
                "SELECT rowid, speaker, text, started_at FROM utterances WHERE utterances MATCH ? "
                "ORDER BY CAST(started_at AS REAL) DESC LIMIT ?", (query, limit)).fetchall()
        except sqlite3.OperationalError:
            return []
        return [(r[0], r[1], r[2], float(r[3])) for r in rows][::-1]


def stamp(started_at):
    return time.strftime("%H:%M:%S", time.localtime(started_at))


def as_text(lines):
    return "\n".join(f"{stamp(started)} {speaker:>4}: {text}" for _, speaker, text, started in lines)


def as_markdown(title, lines):
    body = "\n".join(f"- {stamp(started)} **{speaker}**: {text}" for _, speaker, text, started in lines)
    return f"# {title}\n\n{body or '(nothing was transcribed)'}\n"


