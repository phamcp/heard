def pill(text, slot, name=None, tooltip=None):
    button = QPushButton(text)
    button.setCursor(Qt.PointingHandCursor)
    button.setFocusPolicy(Qt.NoFocus)
    if name:
        button.setObjectName(name)
    if tooltip:
        button.setToolTip(tooltip)
    button.clicked.connect(slot)
    return button


class Overlay(QWidget):
    def __init__(self, store, hide_me, open_settings):
        super().__init__(None, Qt.Tool | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint)
        self.store = store
        self.setAttribute(Qt.WA_TranslucentBackground)
        if IS_MAC:
            self.setAttribute(Qt.WA_MacAlwaysShowToolWindow)
        self.setStyleSheet(STYLE)
        self.expanded = True
        self.drag_offset = None

        self.listen_button = pill("", store.toggle_listening, tooltip=f"Start / stop capturing ({MOD}L)")
        self.assist_button = pill(f"✦ Assist   {MOD}↩", store.assist, "assist", "What should I say next?")
        self.question = QLineEdit()
        self.question.setPlaceholderText("Ask about the conversation…")
        self.question.returnPressed.connect(self.ask)
        self.question.setMinimumWidth(200)
        self.question.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        self.recap_button = pill("Recap", store.recap, tooltip="Summarize the conversation so far")
        self.save_button = pill("Save", store.save_notes, tooltip="Save transcript and answer as Markdown")
        self.expand_button = pill("⌃", self.toggle_expanded, "icon", "Collapse / expand")
        self.settings_button = pill("⚙", open_settings, "icon", "Settings")
        self.hide_button = pill("✕", hide_me, "icon", f"Hide ({MOD}H)")

        bar = QHBoxLayout()
        bar.setContentsMargins(12, 0, 8, 0)
        bar.setSpacing(8)
        for widget in (self.listen_button, self.assist_button, self.question, self.recap_button, self.save_button,
                       self.expand_button, self.settings_button, self.hide_button):
            bar.addWidget(widget)
        bar_widget = QWidget()
        bar_widget.setLayout(bar)
        bar_widget.setFixedHeight(BAR_HEIGHT)

        self.search = QLineEdit()
        self.search.setObjectName("search")
        self.search.setPlaceholderText("Search the retained history…  (Enter; clear to go back live)")
        self.search.returnPressed.connect(lambda: store.search(self.search.text()))
        self.transcript_view = QTextBrowser()
        self.transcript_view.setOpenLinks(False)
        left = QVBoxLayout()
        left.setContentsMargins(0, 0, 0, 0)
        left.setSpacing(6)
        left.addWidget(self.search)
        left.addWidget(self.transcript_view)

        self.answer_title = QLabel("Assist")
        self.answer_title.setObjectName("title")
        self.answer_view = QTextBrowser()
        self.answer_view.setOpenExternalLinks(True)
        right = QVBoxLayout()
        right.setContentsMargins(0, 0, 0, 0)
        right.setSpacing(6)
        right.addWidget(self.answer_title)
        right.addWidget(self.answer_view)
        right_widget = QWidget()
        right_widget.setLayout(right)
        right_widget.setFixedWidth(320)

        panes = QHBoxLayout()
        panes.setContentsMargins(12, 8, 12, 4)
        panes.setSpacing(14)
        panes.addLayout(left, 1)
        panes.addWidget(right_widget)
        self.status = QLabel("")
        self.status.setObjectName("status")
        self.status.setContentsMargins(14, 0, 14, 6)
        self.pane = QWidget()
        pane_layout = QVBoxLayout()
        pane_layout.setContentsMargins(0, 0, 0, 0)
        pane_layout.setSpacing(0)
        pane_layout.addLayout(panes, 1)
        pane_layout.addWidget(self.status)
        self.pane.setLayout(pane_layout)

        root = QVBoxLayout()
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)
        root.addWidget(bar_widget)
        root.addWidget(self.pane, 1)
        self.setLayout(root)

        QShortcut(QKeySequence(Qt.Key_Escape), self, activated=hide_me)
        store.changed.connect(self.render_state)
        store.answer_changed.connect(self.render_answer)
        store.status_changed.connect(self.status.setText)
        self.render_state()
        self.render_answer()
        self.apply_size()

    # window chrome
    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        rect = QRectF(self.rect()).adjusted(0.5, 0.5, -0.5, -0.5)
        painter.setBrush(QColor(20, 20, 25, 232))
        painter.setPen(QColor(255, 255, 255, 36))
        painter.drawRoundedRect(rect, 15, 15)

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.drag_offset = event.globalPosition().toPoint() - self.frameGeometry().topLeft()

    def mouseMoveEvent(self, event):
        if self.drag_offset is not None and event.buttons() & Qt.LeftButton:
            self.move(event.globalPosition().toPoint() - self.drag_offset)

    def mouseReleaseEvent(self, _event):
        self.drag_offset = None

    def toggle_expanded(self):
        self.expanded = not self.expanded
        self.apply_size()

    def apply_size(self):
        self.pane.setVisible(self.expanded)
        self.expand_button.setText("⌃" if self.expanded else "⌄")
        height = BAR_HEIGHT + (PANE_HEIGHT if self.expanded else 0)
        self.setFixedSize(BAR_WIDTH, height)

    def place_at_top(self):
        screen = QApplication.primaryScreen().availableGeometry()
        self.move(QPoint(screen.center().x() - BAR_WIDTH // 2, screen.top() + 10))

    # actions
    def ask(self):
        text = self.question.text().strip()
        if text:
            self.question.clear()
            self.store.ask(text, text)

    # rendering
    def render_state(self):
        store = self.store
        if not store.daemon_running:
            label, color = "Daemon off", "#777"
        elif store.listening:
            minutes = int((time.time() - (store.listening_since or time.time())) / 60)
            label, color = f"Listening · {minutes} min" if minutes else "Listening", "#ff3b30"
        else:
            label, color = "Paused", "#8a8a8a"
        self.listen_button.setText(f"●  {label}   {MOD}L")
        self.listen_button.setStyleSheet(f"color: {color}; font-weight: 600;" if store.listening else "")

        shown = store.search_results if store.search_results is not None else store.lines
        parts = []
        if not shown:
            if store.search_results is not None:
                parts.append('<p style="color:#8a8a8a">No matches.</p>')
            elif store.listening:
                parts.append('<p style="color:#8a8a8a">Listening. Lines appear a few seconds after someone speaks.</p>')
            else:
                parts.append('<p style="color:#8a8a8a">Paused. Nothing is captured until you turn Listening on.</p>')
        for _, speaker, text, started in shown:
            color = "#5aa0ff" if speaker == "me" else "#f0a44a"
            parts.append(f'<div style="margin:0 0 3px 0"><span style="color:#6f6f6f;font-family:Menlo,Consolas,monospace;'
                         f'font-size:10px">{stamp(started)}</span>&nbsp; <b style="color:{color}">{speaker}</b>&nbsp; '
                         f'{escape(text)}</div>')
        if store.search_results is None:
            for speaker, text in store.live:
                parts.append(f'<div style="color:#8a8a8a;margin:0 0 3px 0"><i>… {speaker}: {escape(text)}</i></div>')
        bar = self.transcript_view.verticalScrollBar()
        at_bottom = bar.value() >= bar.maximum() - 4
        html = "".join(parts)
        if html != getattr(self, "_last_html", None):
            self._last_html = html
            self.transcript_view.setHtml(html)
            if at_bottom or store.search_results is not None:
                bar.setValue(bar.maximum())

    def render_answer(self):
        store = self.store
        title = store.answer_title or "Assist"
        self.answer_title.setText(("⏳ " if store.busy else "✦ ") + title)
        if store.answer:
            self.answer_view.setMarkdown(store.answer)
        elif store.busy:
            self.answer_view.setPlainText("")
        else:
            self.answer_view.setMarkdown(f"**Assist** ({MOD}↩) suggests what to say next. **Ask** takes a question about "
                                         "the conversation. **Recap** summarizes it. The transcript goes to Claude only "
                                         "when you press one of these.")


def escape(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


class SettingsDialog(QDialog):
    def __init__(self, store, parent=None):
        super().__init__(parent)
        self.store = store
        self.setWindowTitle("Heard settings")
        self.setWindowFlag(Qt.WindowStaysOnTopHint, True)
        settings = store.settings
        self.key = QLineEdit(settings["api_key"])
        self.key.setEchoMode(QLineEdit.Password)
        self.key.setPlaceholderText("sk-ant-…  (or set ANTHROPIC_API_KEY)")
        self.name = QLineEdit(settings["user_name"])
        self.minutes = QSpinBox()
        self.minutes.setRange(2, 60)
        self.minutes.setValue(int(settings["context_minutes"]))
        self.folder = QLineEdit(settings["notes_folder"])
        browse = QPushButton("Choose…")
        browse.clicked.connect(self.choose_folder)
        folder_row = QHBoxLayout()
        folder_row.addWidget(self.folder)
        folder_row.addWidget(browse)
        self.playbook = QPlainTextEdit(settings["playbook"])
        self.playbook.setPlaceholderText("Who you are, what you sell, what to listen for on calls. Sent to Claude with "
                                         "every Assist / Ask / Recap.")
        self.playbook.setMinimumHeight(120)
        form = QFormLayout()
        form.addRow("Anthropic API key", self.key)
        note = QLabel("Kept owner-only in ~/.local/share/heard/ui-config.json. The transcript is sent to Claude only "
                      "when you press Assist, Ask or Recap, and only the last N minutes.")
        note.setWordWrap(True)
        note.setStyleSheet("color: #888; font-size: 11px;")
        form.addRow("", note)
        form.addRow("Your first name", self.name)
        form.addRow("Minutes of transcript sent", self.minutes)
        form.addRow("Notes folder", folder_row)
        form.addRow("Your playbook", self.playbook)
        buttons = QDialogButtonBox(QDialogButtonBox.Save | QDialogButtonBox.Cancel)
        buttons.accepted.connect(self.save)
        buttons.rejected.connect(self.reject)
        layout = QVBoxLayout()
        layout.addLayout(form)
        layout.addWidget(buttons)
        self.setLayout(layout)
        self.resize(520, 420)

    def choose_folder(self):
        chosen = QFileDialog.getExistingDirectory(self, "Notes folder", self.folder.text())
        if chosen:
            self.folder.setText(chosen)

    def save(self):
        self.store.settings.update({
            "api_key": self.key.text().strip(),
            "user_name": self.name.text().strip() or "me",
            "context_minutes": self.minutes.value(),
            "notes_folder": self.folder.text().strip() or DEFAULT_SETTINGS["notes_folder"],
            "playbook": self.playbook.toPlainText(),
        })
        save_settings(self.store.settings)
        self.accept()


def tray_icon(listening):
    pixmap = QPixmap(44, 44)
    pixmap.fill(Qt.transparent)
    painter = QPainter(pixmap)
    painter.setRenderHint(QPainter.Antialiasing)
    painter.setPen(Qt.NoPen)
    painter.setBrush(QColor("#ff3b30") if listening else QColor(140, 140, 140))
    painter.drawEllipse(6, 6, 32, 32)
    painter.setBrush(QColor(255, 255, 255, 230))
    # a small waveform glyph
    for i, h in enumerate((6, 12, 20, 12, 6)):
        painter.drawRoundedRect(12 + i * 5, 22 - h // 2, 3, h, 1.5, 1.5)
    painter.end()
    icon = QIcon(pixmap)
    return icon


# --- platform glue -----------------------------------------------------------------------------------

def platform_setup(widget):
    """After the window exists: keep it off screen shares, floating over everything, without a Dock icon."""
    if IS_MAC:
        try:
            import objc
            from AppKit import NSApp
            NSApp.setActivationPolicy_(1)   # accessory: no Dock icon, no menu bar takeover
            window = objc.objc_object(c_void_p=int(widget.winId())).window()
            window.setSharingType_(1 if CAPTURABLE else 0)   # NSWindowSharingNone: invisible to screen sharing/recording
            window.setLevel_(3)                               # NSFloatingWindowLevel
            window.setCollectionBehavior_((1 << 0) | (1 << 8))   # all Spaces, over full-screen apps
            window.setHidesOnDeactivate_(False)
            window.setStyleMask_(window.styleMask() | (1 << 7))   # non-activating panel: clicks don't switch apps
        except Exception as error:
            print("heard-ui: macOS window setup incomplete:", error, file=sys.stderr)
    elif IS_WINDOWS and not CAPTURABLE:
        try:
            ctypes.windll.user32.SetWindowDisplayAffinity(int(widget.winId()), 0x11)   # WDA_EXCLUDEFROMCAPTURE
        except Exception as error:
            print("heard-ui: could not exclude the window from capture:", error, file=sys.stderr)


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Heard")
    app.setQuitOnLastWindowClosed(False)
    store = Store()
    settings_dialog = {"open": None}

    def toggle_visible():
        if overlay.isVisible():
            overlay.hide()
        else:
            overlay.show()
            overlay.raise_()

    def open_settings():
        dialog = SettingsDialog(store)
        settings_dialog["open"] = dialog
        if IS_MAC:
            from AppKit import NSApp
            NSApp.activateIgnoringOtherApps_(True)
        dialog.exec()

    overlay = Overlay(store, hide_me=lambda: overlay.hide(), open_settings=open_settings)
    overlay.place_at_top()
    overlay.show()
    platform_setup(overlay)

    tray = QSystemTrayIcon(tray_icon(store.listening))
    menu = QMenu()
    menu.addAction(QAction(f"Show / hide overlay\t{MOD}H", menu, triggered=toggle_visible))
    menu.addAction(QAction(f"Listening on / off\t{MOD}L", menu, triggered=store.toggle_listening))
    menu.addAction(QAction(f"Assist\t{MOD}↩", menu, triggered=lambda: (overlay.show(), store.assist())))
    menu.addSeparator()
    menu.addAction(QAction("Open notes folder", menu, triggered=lambda: open_folder(store.settings["notes_folder"])))
    menu.addAction(QAction("Open transcript folder", menu, triggered=lambda: open_folder(DATA_DIRECTORY)))
    menu.addAction(QAction("Settings…", menu, triggered=open_settings))
    menu.addSeparator()
    menu.addAction(QAction("Quit Heard", menu, triggered=app.quit))
    tray.setContextMenu(menu)
    tray.setToolTip("heard")
    tray.show()
    store.changed.connect(lambda: tray.setIcon(tray_icon(store.listening)))

    def on_hotkey(key_id):
        if key_id == HotKeys.ASSIST:
            overlay.show()
            store.assist()
        elif key_id == HotKeys.TOGGLE_VISIBLE:
            toggle_visible()
        elif key_id == HotKeys.TOGGLE_LISTENING:
            store.toggle_listening()
    hotkeys = HotKeys(app, on_hotkey)   # noqa: F841  (kept alive)

    if os.environ.get("HEARD_UI_SCREENSHOT"):   # development: grab the window and exit
        def shoot():
            overlay.grab().save(os.environ["HEARD_UI_SCREENSHOT"])
            app.quit()
        QTimer.singleShot(int(os.environ.get("HEARD_UI_SCREENSHOT_DELAY", "3000")), shoot)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
