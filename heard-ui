        store.changed.connect(self.render_switch)
        store.status_changed.connect(self.status.setText)
        # switch tabs behind the scenes; only the user expands the collapsed overlay
        store.listening_started.connect(lambda: self.show_tab(0, expand=False))
        store.recording_stopped.connect(lambda: self.show_tab(1, expand=False))
        self.blink = QTimer(self)
        self.blink.timeout.connect(self.toggle_blink)
        self.blink.start(700)
        self.show_tab(0)
        self.render_switch()
        self.apply_size()

    # window chrome
    def paintEvent(self, _event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        listening = self.store.listening and self.expanded   # the collapsed pill never turns red
        rect = QRectF(self.rect()).adjusted(1, 1, -1, -1)
        painter.setBrush(QColor(20, 20, 25, 232))
        pen = QPen(QColor(224, 58, 48, 220 if self.blink_on else 120) if listening else QColor(255, 255, 255, 36))
        pen.setWidth(2 if listening else 1)
        painter.setPen(pen)
        radius = min(15, rect.height() / 2)
        painter.drawRoundedRect(rect, radius, radius)

    def toggle_blink(self):
        if self.store.listening:
            self.blink_on = not self.blink_on
            self.render_switch()
            self.update()
        elif not self.blink_on:
            self.blink_on = True
            self.update()

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self.drag_offset = event.globalPosition().toPoint() - self.frameGeometry().topLeft()

    def mouseMoveEvent(self, event):
        if self.drag_offset is not None and event.buttons() & Qt.LeftButton:
            self.move(event.globalPosition().toPoint() - self.drag_offset)

    def mouseReleaseEvent(self, _event):
        self.drag_offset = None

    def toggle_expanded(self):
        self.expanded = not self.expanded
        self.apply_size()

    def apply_size(self):
        """Expanded: the full bar and pane. Collapsed: a small pill, kept centred where the bar was."""
        centre_x = self.geometry().center().x() if self.isVisible() else None
        self.bar_widget.setVisible(self.expanded)
        self.pane.setVisible(self.expanded)
        self.mini_widget.setVisible(not self.expanded)
        if self.expanded:
            self.setFixedSize(BAR_WIDTH, BAR_HEIGHT + PANE_HEIGHT)
        else:
            self.setFixedSize(MINI_WIDTH, MINI_HEIGHT)
        if centre_x is not None:
            screen = (self.screen() or QApplication.primaryScreen()).availableGeometry()
            x = min(max(centre_x - self.width() // 2, screen.left()), screen.right() - self.width())
            self.move(x, self.y())
        self.update()

    def place_at_top(self):
        screen = QApplication.primaryScreen().availableGeometry()
        self.move(QPoint(screen.center().x() - BAR_WIDTH // 2, screen.top() + 10))

    def show_tab(self, index, expand=True):
        self.stack.setCurrentIndex(index)
        self.logs_tab.setProperty("active", "true" if index == 1 else "false")
        repolish(self.logs_tab)
        if index == 1:
            self.logs_pane.reload()
        if expand and not self.expanded:
            self.toggle_expanded()

    def toggle_logs(self):
        self.show_tab(0 if self.stack.currentIndex() == 1 else 1)

    # rendering
    def render_switch(self):
        store = self.store
        if not store.daemon_running:
            state, label = "off", "○  Daemon off"
        elif store.listening:
            minutes = int((time.time() - (store.session_start or time.time())) / 60)
            dot = "●" if self.blink_on else "○"
            state, label = "listening", f"{dot}  Listening · {minutes} min  ·  Pause" if minutes else f"{dot}  Listening  ·  Pause"
        else:
            state, label = "paused", "▶  Start listening"
        self.switch.setText(f"{label}   {MOD}L")
        self.logo_button.setIcon(tray_icon(False))   # collapsed stays neutral: no colour, no blinking
        self.mini_switch.setIcon(glyph_icon("pause" if store.listening else "play"))
        self.mini_switch.setEnabled(store.daemon_running)
        if self.switch.property("state") != state:
            self.switch.setProperty("state", state)
            repolish(self.switch)
            self.update()


def escape(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


class SettingsDialog(QDialog):
    def __init__(self, store, parent=None):
        super().__init__(parent)
        self.store = store
        self.setWindowTitle("Heard settings")
        self.setWindowFlag(Qt.WindowStaysOnTopHint, True)
        self.folder = QLineEdit(store.settings["notes_folder"])
        browse = QPushButton("Choose…")
        browse.clicked.connect(self.choose_folder)
        folder_row = QHBoxLayout()
        folder_row.addWidget(self.folder)
        folder_row.addWidget(browse)
        self.summarizer = QComboBox()
        for label, value in (("Local model (Ollama): nothing leaves this machine", "local"),
                             ("Claude API: sends each transcript to Anthropic", "claude"),
                             ("Off: keyword titles only", "off")):
            self.summarizer.addItem(label, value)
        self.summarizer.setCurrentIndex(max(0, self.summarizer.findData(store.settings.get("summarizer", "local"))))
        self.local_model = QLineEdit(store.settings.get("local_model") or DEFAULT_SETTINGS["local_model"])
        self.local_model.setToolTip("Any model you have pulled in Ollama, e.g. gemma3:12b or qwen2.5:7b")
        form = QFormLayout()
        form.addRow("Library folder (Stop recording writes here)", folder_row)
        form.addRow("Meeting titles and summaries", self.summarizer)
        form.addRow("Local model", self.local_model)
        note = QLabel(f"The rolling transcript itself lives in {DATA_DIRECTORY}, readable only by you, and is "
                      "deleted after a few days. Logs in this folder are kept until you delete them. Nothing leaves "
                      "the machine unless you choose the Claude API for summaries (it reads ANTHROPIC_API_KEY).")
        note.setWordWrap(True)
        note.setStyleSheet("color: #888; font-size: 11px;")
        form.addRow("", note)
        buttons = QDialogButtonBox(QDialogButtonBox.Save | QDialogButtonBox.Cancel)
        buttons.accepted.connect(self.save)
        buttons.rejected.connect(self.reject)
        layout = QVBoxLayout()
        layout.addLayout(form)
        layout.addWidget(buttons)
        self.setLayout(layout)
        self.resize(520, 160)

    def choose_folder(self):
        chosen = QFileDialog.getExistingDirectory(self, "Library folder", self.folder.text())
        if chosen:
            self.folder.setText(chosen)

    def save(self):
        self.store.settings["notes_folder"] = self.folder.text().strip() or DEFAULT_SETTINGS["notes_folder"]
        self.store.settings["summarizer"] = self.summarizer.currentData()
        self.store.settings["local_model"] = self.local_model.text().strip() or DEFAULT_SETTINGS["local_model"]
        save_settings(self.store.settings)
        self.store.logs_changed.emit()
        self.accept()


def tray_icon(listening, size=44):
    pixmap = QPixmap(size, size)
    pixmap.fill(Qt.transparent)
    painter = QPainter(pixmap)
    painter.setRenderHint(QPainter.Antialiasing)
    painter.scale(size / 44, size / 44)   # drawn on a 44 px grid
    painter.setPen(Qt.NoPen)
    painter.setBrush(QColor("#ff3b30") if listening else QColor(140, 140, 140))
    painter.drawEllipse(6, 6, 32, 32)
    painter.setBrush(QColor(255, 255, 255, 230))
    for i, h in enumerate((6, 12, 20, 12, 6)):   # a small waveform glyph
        painter.drawRoundedRect(12 + i * 5, 22 - h // 2, 3, h, 1.5, 1.5)
    painter.end()
    return QIcon(pixmap)


def glyph_icon(kind):
    """Play / pause / stop drawn rather than typed, so they look the same with every system font."""
    pixmap = QPixmap(24, 24)
    pixmap.fill(Qt.transparent)
    painter = QPainter(pixmap)
    painter.setRenderHint(QPainter.Antialiasing)
    painter.setPen(Qt.NoPen)
    painter.setBrush(QColor("#d0d0d0"))
    if kind == "play":
        painter.drawPolygon(QPolygon([QPoint(7, 4), QPoint(20, 12), QPoint(7, 20)]))
    elif kind == "pause":
        painter.drawRoundedRect(5, 4, 5, 16, 1.5, 1.5)
        painter.drawRoundedRect(14, 4, 5, 16, 1.5, 1.5)
    else:
        painter.drawRoundedRect(5, 5, 14, 14, 2.5, 2.5)
    painter.end()
    return QIcon(pixmap)


# --- platform glue -----------------------------------------------------------------------------------

def platform_setup(widget):
    """After the window exists: keep it off screen shares, floating over everything, without a Dock icon."""
    if IS_MAC:
        try:
            import objc
            from AppKit import NSApp
            NSApp.setActivationPolicy_(1)   # accessory: no Dock icon, no menu bar takeover
            window = objc.objc_object(c_void_p=int(widget.winId())).window()
            window.setSharingType_(1 if CAPTURABLE else 0)   # NSWindowSharingNone: invisible to screen sharing/recording
            window.setLevel_(3)                               # NSFloatingWindowLevel
            window.setCollectionBehavior_((1 << 0) | (1 << 8))   # all Spaces, over full-screen apps
            window.setHidesOnDeactivate_(False)
            window.setStyleMask_(window.styleMask() | (1 << 7))   # non-activating panel: clicks don't switch apps
        except Exception as error:
            print("heard-ui: macOS window setup incomplete:", error, file=sys.stderr)
    elif IS_WINDOWS and not CAPTURABLE:
        try:
            import ctypes.wintypes as wintypes
            user32 = ctypes.windll.user32
            user32.SetWindowDisplayAffinity.argtypes = [wintypes.HWND, wintypes.DWORD]
            user32.SetWindowDisplayAffinity.restype = wintypes.BOOL
            if not user32.SetWindowDisplayAffinity(int(widget.winId()), 0x11):   # WDA_EXCLUDEFROMCAPTURE
                print("heard-ui: could not hide the window from screen capture (needs Windows 10 2004 or newer)",
                      file=sys.stderr)
        except Exception as error:
            print("heard-ui: could not exclude the window from capture:", error, file=sys.stderr)


def single_instance(name):
    """An exclusive lock held for the life of the process; None if another overlay already runs."""
    DATA_DIRECTORY.mkdir(parents=True, exist_ok=True)
    handle = open(DATA_DIRECTORY / f"{name}.lock", "a+")
    try:
        if IS_WINDOWS:
            import msvcrt
            handle.seek(0)
            msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
        else:
            import fcntl
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None
    return handle


def main():
    if IS_WINDOWS:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
    if sys.argv[1:2] == ["--write-icon"]:   # used by windows/install.ps1 for the desktop shortcut
        app = QApplication(sys.argv[:1])
        written = tray_icon(False, 256).pixmap(256, 256).save(sys.argv[2], "ICO")
        return 0 if written else 1
    lock = None if os.environ.get("HEARD_UI_SCREENSHOT") else single_instance("ui")
    if lock is None and not os.environ.get("HEARD_UI_SCREENSHOT"):
        SHOW_REQUEST.touch()   # the running overlay picks this up and comes to the front
        print("heard-ui: already running; asked it to show", file=sys.stderr)
        return 0
    app = QApplication(sys.argv)
    app.setApplicationName("Heard")
    app.setQuitOnLastWindowClosed(False)
    store = Store()

    def toggle_visible():
        if overlay.isVisible():
            overlay.hide()
        else:
            overlay.show()
            overlay.raise_()

    def open_settings():
        if IS_MAC:
            from AppKit import NSApp
            NSApp.activateIgnoringOtherApps_(True)
        SettingsDialog(store).exec()

    overlay = Overlay(store, hide_me=lambda: overlay.hide(), open_settings=open_settings)
    overlay.place_at_top()
    overlay.show()
    platform_setup(overlay)
    SHOW_REQUEST.unlink(missing_ok=True)

    def check_show_request():
        if SHOW_REQUEST.exists():
            SHOW_REQUEST.unlink(missing_ok=True)
            overlay.show()
            overlay.raise_()
    show_timer = QTimer(app)
    show_timer.timeout.connect(check_show_request)
    show_timer.start(500)

    tray = QSystemTrayIcon(tray_icon(store.listening))
    menu = QMenu()
    menu.addAction(QAction(f"Show / hide overlay\t{MOD}H", menu, triggered=toggle_visible))
    menu.addAction(QAction(f"Start / pause listening\t{MOD}L", menu, triggered=store.toggle_listening))
    menu.addAction(QAction("Stop recording (file in library)", menu, triggered=store.stop_recording))
    menu.addSeparator()
    menu.addAction(QAction("Library", menu, triggered=lambda: (overlay.show(), overlay.show_tab(1))))
    menu.addAction(QAction("Open library folder", menu, triggered=lambda: open_folder(store.settings["notes_folder"])))
    menu.addAction(QAction("Settings…", menu, triggered=open_settings))
    menu.addSeparator()
    menu.addAction(QAction("Quit Heard", menu, triggered=app.quit))
    tray.setContextMenu(menu)
    tray.setToolTip("heard")
    tray.show()
    store.changed.connect(lambda: tray.setIcon(tray_icon(store.listening)))

    def on_hotkey(key_id):
        if key_id == HotKeys.TOGGLE_VISIBLE:
            toggle_visible()
        elif key_id == HotKeys.TOGGLE_LISTENING:
            store.toggle_listening()
    app.heard_hotkeys = HotKeys(app, on_hotkey)   # kept alive with the app

    if os.environ.get("HEARD_UI_SCREENSHOT"):   # development: grab the window and exit
        def shoot():
            if os.environ.get("HEARD_UI_TAB") == "logs":
                overlay.show_tab(1)
            elif os.environ.get("HEARD_UI_TAB") == "mini":
                overlay.toggle_expanded()
            overlay.grab().save(os.environ["HEARD_UI_SCREENSHOT"])
            app.quit()
        QTimer.singleShot(int(os.environ.get("HEARD_UI_SCREENSHOT_DELAY", "3000")), shoot)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
