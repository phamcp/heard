def make_title(lines, phrases=3):
    """A title from the transcript's own words: the most prominent phrases (bigrams first, then single words),
    keeping their original spelling. Offline keyword extraction, not a summary."""
    words = []
    for _, _, text, _ in lines:
        for sentence in re.split(r"[.!?;:]", text):
            words.append([w for w in re.findall(r"[A-Za-z][A-Za-z0-9'\-]*", sentence)])
    unigram_counts, bigram_counts, surface = {}, {}, {}

    def keep(word):
        low = word.lower()
        return len(low) >= 3 and low not in STOPWORDS

    for sentence in words:
        kept = [w for w in sentence if keep(w)]
        for word in kept:
            low = word.lower()
            unigram_counts[low] = unigram_counts.get(low, 0) + 1
            surface.setdefault(low, {})
            surface[low][word] = surface[low].get(word, 0) + 1
        for a, b in zip(sentence, sentence[1:]):
            if keep(a) and keep(b):
                key = (a.lower(), b.lower())
                bigram_counts[key] = bigram_counts.get(key, 0) + 1
    total = sum(unigram_counts.values())
    if not total:
        return ""
    min_count = 1 if total < 40 else 2
    candidates = [(count * 2.5, key) for key, count in bigram_counts.items() if count >= min_count]
    candidates += [(float(count), (key,)) for key, count in unigram_counts.items() if count >= min_count]
    candidates.sort(key=lambda item: (-item[0], item[1]))
    chosen, used = [], set()
    for _, key in candidates:
        if any(part in used for part in key):
            continue
        chosen.append(" ".join(max(surface[part], key=surface[part].get) for part in key))
        used.update(key)
        if len(chosen) == phrases:
            break
    return ", ".join(chosen)


def safe_filename(text, limit=60):
    text = re.sub(r"[^\w \-',]", "", text).strip()
    return text[:limit].rstrip(" ,")


# --- meeting summaries ----------------------------------------------------------------------------------
# After Stop recording the log is written at once with a keyword title; then a language model names the
# meeting and adds a summary, key points and action items at the top. "local" (the default) asks Ollama on
# this machine, so nothing leaves it; "claude" sends the transcript to the Anthropic API; "off" skips it.

OLLAMA_URL = os.environ.get("HEARD_OLLAMA_URL", "http://127.0.0.1:11434")
SUMMARY_CHUNK_CHARS = 40000   # about 10k tokens per pass; longer calls are summarized in parts, then combined
SUMMARY_SCHEMA = {
    "type": "object",
    "properties": {
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "key_points": {"type": "array", "items": {"type": "string"}},
        "action_items": {"type": "array", "items": {"type": "string"}},
    },
    "required": ["title", "summary", "key_points", "action_items"],
}
SUMMARY_PROMPT = """You are given the transcript of a call, transcribed automatically, so expect some misheard words.
"me" is the person who recorded the call; "them" is everyone else on the call, mixed together.

Return a JSON object with:
- title: what the meeting was about, 3 to 8 words. Be specific: name the company, product or topic from the call.
  No date, no quotes, no trailing period.
- summary: 2 to 4 plain sentences on who met, what for, and where it landed.
- key_points: up to 7 short bullets with the substance: decisions, numbers, dates, objections, open questions.
- action_items: who does what and by when, only if it was said in the call. An empty list if there were none.

Write plain business English. Use only what is in the transcript; never invent names, numbers or commitments.
Do not use em dashes."""
LOG_LINE = re.compile(r"^- (\d\d:\d\d:\d\d) \*\*(\w+)\*\*: (.*)$")


def _http_json(url, payload=None, headers=None, timeout=60, use_proxy=True):
    import urllib.request
    data = json.dumps(payload).encode("utf-8") if payload is not None else None
    request = urllib.request.Request(url, data=data, headers={"content-type": "application/json", **(headers or {})})
    opener = urllib.request.build_opener() if use_proxy else urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def _ask_local(model, system, user):
    reply = _http_json(f"{OLLAMA_URL}/api/chat", {
        "model": model, "stream": False, "format": SUMMARY_SCHEMA, "keep_alive": "5m",
        "options": {"temperature": 0.2, "num_ctx": 16384},
        "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}],
    }, timeout=900, use_proxy=False)
    return json.loads(reply["message"]["content"])


def _claude_key():
    key = os.environ.get("ANTHROPIC_API_KEY", "")
    if not key and IS_WINDOWS:   # set with setx after the overlay started: read the user environment directly
        import winreg
        try:
            with winreg.OpenKey(winreg.HKEY_CURRENT_USER, "Environment") as env:
                key = winreg.QueryValueEx(env, "ANTHROPIC_API_KEY")[0]
        except OSError:
            pass
    if not key:
        raise RuntimeError("no ANTHROPIC_API_KEY set")
    return key


def _claude_model(key):
    """HEARD_CLAUDE_MODEL, else the newest Sonnet the key can use (the models list is newest first)."""
    if os.environ.get("HEARD_CLAUDE_MODEL"):
        return os.environ["HEARD_CLAUDE_MODEL"]
    listing = _http_json("https://api.anthropic.com/v1/models?limit=100",
                         headers={"x-api-key": key, "anthropic-version": "2023-06-01"}, timeout=30)
    ids = [model["id"] for model in listing.get("data", [])]
    return next((i for i in ids if "sonnet" in i), ids[0] if ids else "")


def _ask_claude(system, user):
    key = _claude_key()
    reply = _http_json("https://api.anthropic.com/v1/messages", {
        "model": _claude_model(key), "max_tokens": 2000, "temperature": 0.2,
        "system": system + "\nReply with only the JSON object.",
        "messages": [{"role": "user", "content": user}],
    }, headers={"x-api-key": key, "anthropic-version": "2023-06-01"}, timeout=300)
    text = "".join(block.get("text", "") for block in reply.get("content", []))
    return json.loads(text[text.find("{"):text.rfind("}") + 1])


def _tidy(result):
    def plain(text):
        text = str(text).strip().replace(" \u2014 ", ", ").replace("\u2014", ", ").replace(" \u2013 ", ", ")
        return re.sub(r"\s+", " ", text)
    title = plain(result.get("title", "")).strip("\"'*#").rstrip(".")[:80]
    return {"title": title,
            "summary": plain(result.get("summary", "")),
            "key_points": [plain(p) for p in result.get("key_points", []) if str(p).strip()][:7],
            "action_items": [plain(p) for p in result.get("action_items", []) if str(p).strip()][:10]}


def summarize_transcript(text, settings):
    """{"title", "summary", "key_points", "action_items"} for a transcript in `as_text` form. Raises on failure."""
    if settings.get("summarizer") == "claude":
        ask = _ask_claude
    else:
        model = settings.get("local_model") or DEFAULT_SETTINGS["local_model"]
        ask = lambda system, user: _ask_local(model, system, user)
    if len(text) <= SUMMARY_CHUNK_CHARS:
        return _tidy(ask(SUMMARY_PROMPT, text))
    parts, current = [], ""
    for line in text.splitlines(keepends=True):
        if current and len(current) + len(line) > SUMMARY_CHUNK_CHARS:
            parts.append(current)
            current = ""
        current += line
    parts.append(current)
    notes = []
    for number, part in enumerate(parts, 1):
        result = _tidy(ask(SUMMARY_PROMPT + f"\n\nThis is part {number} of {len(parts)} of one long call.", part))
        notes.append(f"Part {number}: {result['summary']}\n" +
                     "\n".join(f"- {point}" for point in result["key_points"] + result["action_items"]))
    return _tidy(ask(SUMMARY_PROMPT + "\n\nInstead of the transcript you get notes on consecutive parts of one call. "
                     "Combine them into one result for the whole call.", "\n\n".join(notes)))


def render_log(title, detail, transcript_md, summary=None):
    """The log file: title, when, then (once summarized) Summary / Key points / Action items, then the transcript."""
    parts = [f"# {title}", f"_{detail}_" if detail else ""]
    if summary:
        parts += ["## Summary", summary["summary"] or "(no summary)"]
        if summary["key_points"]:
            parts += ["## Key points", "\n".join(f"- {point}" for point in summary["key_points"])]
        if summary["action_items"]:
            parts += ["## Action items", "\n".join(f"- {item}" for item in summary["action_items"])]
        parts.append("## Transcript")
    parts.append(transcript_md or "(nothing was transcribed)")
    return "\n\n".join(part for part in parts if part) + "\n"


def read_log(path):
    """(title, detail, transcript markdown, transcript as text) from a log file, old or new layout."""
    title, detail, transcript, text = "", "", [], []
    for line in Path(path).read_text(encoding="utf-8").splitlines():
        match = LOG_LINE.match(line)
        if match:
            transcript.append(line)
            text.append(f"{match.group(1)} {match.group(2):>4}: {match.group(3).replace('**', '')}")
        elif line.startswith("# ") and not title:
            title = line[2:].strip()
        elif line.startswith("_") and line.endswith("_") and not detail:
            detail = line.strip("_")
    return title, detail, "\n".join(transcript), "\n".join(text)


def describe_summary_error(error, settings):
    """A one-line reason for the status bar; the log keeps its keyword title either way."""
    import urllib.error
    if settings.get("summarizer") == "claude":
        if isinstance(error, RuntimeError):
            return "set ANTHROPIC_API_KEY to use Claude, or pick Local in Settings"
        if isinstance(error, urllib.error.HTTPError):
            return f"the Claude API answered {error.code}"
        return f"could not reach the Claude API ({error})"
    if isinstance(error, urllib.error.HTTPError) and error.code == 404:
        return f"Ollama has no model {settings.get('local_model')}: run  ollama pull {settings.get('local_model')}"
    if isinstance(error, urllib.error.HTTPError):
        return f"Ollama answered {error.code} (out of GPU memory?); try Summarize again"
    if isinstance(error, (urllib.error.URLError, ConnectionError, TimeoutError)):
        return "Ollama is not running (install it from ollama.com and start it, or turn summaries off in Settings)"
    return f"the model's answer was unusable ({error.__class__.__name__}); try Summarize again"


# --- state --------------------------------------------------------------------------------------------

class Store(QObject):
    changed = Signal()          # transcript / live / listening / daemon state
    logs_changed = Signal()
    status_changed = Signal(str)
    listening_started = Signal()
    recording_stopped = Signal()
    summary_finished = Signal(str, object, str)   # log path, summary (or None), error; emitted from a worker thread

    def __init__(self):
        super().__init__()
        self.summarizing = set()      # log paths with a summary in progress
        self.summary_finished.connect(self._apply_summary)
        self.transcript = Transcript()
        self.settings = load_settings()
        self.lines = []
        self.live = []
        self.listening = False
        self.daemon_running = False
        self.search_results = None
        self.last_log_path = None     # the log Stop recording just wrote; the Library opens on it
        self.session_start = self._load_session()
        # show the current call from its start, else the last three hours, but never what Stop recording cleared
        self.newest = (self.session_start - 1) if self.session_start else max(
            time.time() - 3 * 3600, float(self.settings.get("view_since") or 0))
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(500)
        self.refresh()

    # sessions
    @staticmethod
    def _load_session():
        try:
            return float(json.loads(SESSION_PATH.read_text(encoding="utf-8"))["started_at"])
        except (OSError, ValueError, KeyError, TypeError):
            return None

    def start_listening(self):
        if not self.daemon_running:
            self.status_changed.emit("heard-daemon is not running: install it first (macos/install.sh or windows/install.ps1)")
            return
        DATA_DIRECTORY.mkdir(parents=True, exist_ok=True)
        if self.session_start is None:
            self.session_start = time.time()
            SESSION_PATH.write_text(json.dumps({"started_at": self.session_start}), encoding="utf-8")
            os.chmod(SESSION_PATH, 0o600)
        PAUSE_FLAG.unlink(missing_ok=True)
        self.refresh()
        self.listening_started.emit()

    def pause_listening(self):
        """Pause capture only: the transcript stays on screen and the call stays open."""
        DATA_DIRECTORY.mkdir(parents=True, exist_ok=True)
        PAUSE_FLAG.touch()
        self.refresh()

    def toggle_listening(self):
        if self.listening:
            self.pause_listening()
        else:
            self.start_listening()

    def stop_recording(self):
        """File the transcript shown in the library, clear the view, pause, and close the call."""
        lines = self.shown_lines()
        if lines:
            started = self.session_start or lines[0][3]
            ended = max(lines[-1][3], time.time() if self.listening else lines[-1][3])
            minutes = max(1, int(round((ended - started) / 60)))
            detail = (f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(started))}–"
                      f"{time.strftime('%H:%M', time.localtime(ended))}, {minutes} min, {len(lines)} lines")
            self.write_log(started, lines, detail, "Recording stopped")
        else:
            self.status_changed.emit("Nothing to file; paused")
        DATA_DIRECTORY.mkdir(parents=True, exist_ok=True)
        PAUSE_FLAG.touch()
        self.session_start = None
        SESSION_PATH.unlink(missing_ok=True)
        self.clear_view()
        self.refresh()
        if lines:
            self.recording_stopped.emit()

    def write_log(self, started, lines, detail, verb):
        """A Markdown log filed by start time: written at once with a keyword title, then summarized and
        renamed in the background (see summarize_log)."""
        topic = make_title(lines) or "untitled"
        when = time.strftime("%Y-%m-%d %H.%M", time.localtime(started))
        path = self.log_folder() / f"{when} {safe_filename(topic)}{LOG_SUFFIX}"
        try:
            path.write_text(as_markdown(f"{topic}\n\n_{detail}_", lines), encoding="utf-8")
            os.chmod(path, 0o600)
            self.last_log_path = str(path)
            self.status_changed.emit(f"{verb}. Log saved: {topic}")
        except OSError as error:
            self.status_changed.emit(f"{verb}, but could not write the log: {error}")
            path = None
        self.logs_changed.emit()
        if path and self.settings.get("summarizer", "local") != "off":
            self.summarize_log(str(path))

    def summarize_log(self, path):
        """Name the meeting and add a summary, key points and action items to a log, in a worker thread."""
        if path in self.summarizing:
            return
        if self.settings.get("summarizer") == "off":
            self.status_changed.emit("Summaries are off (Settings)")
            return
        try:
            _, _, _, text = read_log(path)
        except OSError as error:
            self.status_changed.emit(f"Could not read the log: {error}")
            return
        if not text.strip():
            self.status_changed.emit("Nothing to summarize in this log")
            return
        self.summarizing.add(path)
        settings = dict(self.settings)
        engine = "Claude" if settings.get("summarizer") == "claude" else settings.get("local_model")
        self.status_changed.emit(f"Summarizing the call with {engine}...")

        def work():
            try:
                self.summary_finished.emit(path, summarize_transcript(text, settings), "")
            except Exception as error:   # network, model or JSON trouble: keep the keyword title
                self.summary_finished.emit(path, None, describe_summary_error(error, settings))

        import threading
        threading.Thread(target=work, daemon=True).start()

    def _apply_summary(self, path, summary, error):
        """Back on the UI thread: rewrite the log with the summary on top and rename it after the meeting."""
        self.summarizing.discard(path)
        if summary is None:
            self.status_changed.emit(f"Summary skipped: {error}")
            return
        old = Path(path)
        if not old.exists():
            return   # deleted while the model was working
        try:
            _, detail, transcript_md, _ = read_log(old)
            title = summary["title"] or old.name[17:-len(LOG_SUFFIX)] or "untitled"
            new = old.with_name(f"{old.name[:16]} {safe_filename(title)}{LOG_SUFFIX}")
            number = 2
            while new != old and new.exists():
                new = old.with_name(f"{old.name[:16]} {safe_filename(title)} ({number}){LOG_SUFFIX}")
                number += 1
            new.write_text(render_log(title, detail, transcript_md, summary), encoding="utf-8")
            os.chmod(new, 0o600)
            if new != old:
                old.unlink()
            self.last_log_path = str(new)
            self.status_changed.emit(f"Summarized: {title}")
        except OSError as error:
            self.status_changed.emit(f"Could not update the log: {error}")
        self.logs_changed.emit()

    def clear_view(self):
        """Empty the live view (the log keeps the text), also for the next overlay start."""
        self.lines = []
        self.search_results = None
        self.newest = time.time()
        self.settings["view_since"] = self.newest
        save_settings(self.settings)
        self.changed.emit()

    def log_folder(self):
        folder = Path(self.settings["notes_folder"])
        folder.mkdir(parents=True, exist_ok=True)
        return folder

    def logs(self):
        try:
            files = [p for p in self.log_folder().iterdir() if p.name.endswith(LOG_SUFFIX)]
        except OSError:
            return []
        return sorted(files, key=lambda p: p.name, reverse=True)

    # polling
    def refresh(self):
        fresh = self.transcript.since(self.newest)
        if fresh:
            self.lines.extend(fresh)
            del self.lines[:-600]
            self.newest = fresh[-1][3]
        try:
            self.daemon_running = time.time() - HEARTBEAT_PATH.stat().st_mtime < 8
        except OSError:
            self.daemon_running = False
        self.listening = self.daemon_running and not PAUSE_FLAG.exists()
        live = []
        try:
            now = time.time()
            for speaker, entry in sorted(json.loads(LIVE_PATH.read_text(encoding="utf-8")).items()):
                if now - entry["updated_at"] < 6:
                    live.append((speaker, entry["text"]))
        except (OSError, ValueError, KeyError):
            pass
        self.live = live
        self.changed.emit()

    def search(self, query):
        query = query.strip()
        self.search_results = self.transcript.search(query) if query else None
        self.changed.emit()

    # copy / save
    def shown_lines(self):
        return self.search_results if self.search_results is not None else self.lines

    def copy_transcript(self):
        lines = self.shown_lines()
        QApplication.clipboard().setText(as_text(lines))
        self.status_changed.emit(f"Copied {len(lines)} lines to the clipboard")


def reveal(path):
    if IS_MAC:
        subprocess.Popen(["open", "-R", str(path)])
    elif IS_WINDOWS:
        subprocess.Popen(["explorer", "/select,", str(path)])
    else:
        subprocess.Popen(["xdg-open", str(path.parent)])


def open_folder(path):
    Path(path).mkdir(parents=True, exist_ok=True)
    if IS_MAC:
        subprocess.Popen(["open", str(path)])
    elif IS_WINDOWS:
        os.startfile(str(path))   # noqa
    else:
        subprocess.Popen(["xdg-open", str(path)])


# --- global hotkeys (no permissions needed): Carbon on macOS, RegisterHotKey on Windows ----------------

class HotKeys:
    TOGGLE_VISIBLE, TOGGLE_LISTENING = 1, 2

    def __init__(self, app, callback):
        self.callback = callback
        self._keep = []
        try:
            if IS_MAC:
                self._mac()
            elif IS_WINDOWS:
                self._windows(app)
        except Exception as error:   # hotkeys are a convenience; the UI works without them
            print("heard-ui: global hotkeys unavailable:", error, file=sys.stderr)

    def _mac(self):
        carbon = ctypes.CDLL("/System/Library/Frameworks/Carbon.framework/Carbon")

        class EventHotKeyID(ctypes.Structure):
            _fields_ = [("signature", ctypes.c_uint32), ("id", ctypes.c_uint32)]

        class EventTypeSpec(ctypes.Structure):
            _fields_ = [("eventClass", ctypes.c_uint32), ("eventKind", ctypes.c_uint32)]

        handler_type = ctypes.CFUNCTYPE(ctypes.c_int32, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p)
        carbon.GetApplicationEventTarget.restype = ctypes.c_void_p
        carbon.InstallEventHandler.argtypes = [ctypes.c_void_p, handler_type, ctypes.c_uint32,
                                               ctypes.POINTER(EventTypeSpec), ctypes.c_void_p, ctypes.c_void_p]
        carbon.RegisterEventHotKey.argtypes = [ctypes.c_uint32, ctypes.c_uint32, EventHotKeyID, ctypes.c_void_p,
                                               ctypes.c_uint32, ctypes.POINTER(ctypes.c_void_p)]
        carbon.GetEventParameter.argtypes = [ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_void_p,
                                             ctypes.c_uint32, ctypes.c_void_p, ctypes.c_void_p]

        def handler(_next, event, _data):
            hot_key = EventHotKeyID()
            carbon.GetEventParameter(event, 0x2D2D2D2D, 0x686B6964, None, ctypes.sizeof(hot_key), None,
                                     ctypes.byref(hot_key))   # '----', 'hkid'
            self.callback(hot_key.id)
            return 0

        handler_c = handler_type(handler)
        target = carbon.GetApplicationEventTarget()
        spec = EventTypeSpec(0x6B657962, 5)   # 'keyb', kEventHotKeyPressed
        carbon.InstallEventHandler(target, handler_c, 1, ctypes.byref(spec), None, None)
        self._keep += [handler_c, spec]
        command_shift = (1 << 8) | (1 << 9)
        for key_id, key_code in ((self.TOGGLE_VISIBLE, 4), (self.TOGGLE_LISTENING, 37)):   # H, L
            ref = ctypes.c_void_p()
            carbon.RegisterEventHotKey(key_code, command_shift, EventHotKeyID(0x48454152, key_id), target, 0,
                                       ctypes.byref(ref))
            self._keep.append(ref)

    def _windows(self, app):
        import ctypes.wintypes as wintypes
        user32 = ctypes.windll.user32
        user32.RegisterHotKey.argtypes = [wintypes.HWND, ctypes.c_int, wintypes.UINT, wintypes.UINT]
        user32.RegisterHotKey.restype = wintypes.BOOL
        mod_control_shift_norepeat = 0x0002 | 0x0004 | 0x4000
        for key_id, virtual_key, label in ((self.TOGGLE_VISIBLE, 0x48, "Ctrl+Shift+H"),
                                           (self.TOGGLE_LISTENING, 0x4C, "Ctrl+Shift+L")):
            if not user32.RegisterHotKey(None, key_id, mod_control_shift_norepeat, virtual_key):
                print(f"heard-ui: {label} is taken by another app; use the overlay or tray menu instead",
                      file=sys.stderr)

        callback = self.callback

        class Filter(QAbstractNativeEventFilter):
            def nativeEventFilter(self, event_type, message):
                msg = wintypes.MSG.from_address(int(message))
                if msg.message == 0x0312 and not msg.hWnd:   # WM_HOTKEY, posted to this thread (hwnd NULL)
                    callback(int(msg.wParam))
                return False, 0

        self._filter = Filter()
        app.installNativeEventFilter(self._filter)


