#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "faster-whisper>=1.1",
#   "numpy",
#   "nvidia-cublas-cu12; sys_platform != 'darwin'",
#   "nvidia-cudnn-cu12>=9,<10; sys_platform != 'darwin'",
#   "PyAudioWPatch>=0.2.12; sys_platform == 'win32'",
# ]
# ///
"""heard-daemon: local, real-time transcript of what you say and what you hear.

Two read-only capture streams feed a local Whisper model:
  - "them": whatever is played to the current default output, re-resolved every few seconds so it
    follows you when you switch between speakers and headphones (Zoom, Slack, Meet, …)
  - "me":   the default microphone
Capturing never changes routing: no modules are loaded, no streams are moved, no virtual device is added.

Per platform, the capture is a child process that writes 16 kHz mono s16le PCM to its stdout:
  Linux    parec on the default sink's monitor and on the default source (PulseAudio / PipeWire)
  macOS    heard-tap (macos/heard-tap.swift): a Core Audio process tap for "them", the input device for "me"
  Windows  this script in `tap` mode (PyAudioWPatch): the WASAPI loopback of the default output for "them",
           the default microphone for "me"
While capture is paused there is no capture process at all, so the system's microphone indicator is off.

Utterances go into ~/.local/share/heard/heard.db (SQLite FTS5); `heard` searches them.
Nothing leaves the machine. Capture is off until `heard resume` (or the overlay's Listening switch) turns it
on, pauses itself after HEARD_MAX_LISTEN_MINUTES (default 180), and rows older than HEARD_RETENTION_DAYS
(default 3) are deleted hourly.

Environment overrides: HEARD_THEM_SOURCE, HEARD_ME_SOURCE, HEARD_MODEL, HEARD_CPU_MODEL, HEARD_CPU_THREADS,
HEARD_RETENTION_DAYS, HEARD_MAX_LISTEN_MINUTES, HEARD_START_LISTENING (capture from boot instead of starting paused).
"""
import ctypes
import glob
import importlib.util
import json
import os
import queue
import shutil
import signal
import sqlite3
import subprocess
import sys
import threading
import time
from pathlib import Path

import numpy

IS_MAC = sys.platform == "darwin"
IS_WINDOWS = sys.platform == "win32"
IS_LINUX = not (IS_MAC or IS_WINDOWS)

SAMPLE_RATE = 16000
FRAME_SECONDS = 0.03
FRAME_SAMPLES = int(SAMPLE_RATE * FRAME_SECONDS)
SILENCE_TO_CLOSE_SECONDS = 0.5      # a pause this long ends an utterance
MAX_UTTERANCE_SECONDS = 10.0        # long monologues are cut so final text shows up promptly
PARTIAL_INTERVAL_SECONDS = 1.0      # while someone talks, re-transcribe the utterance so far this often
MIN_SPEECH_SECONDS = 0.4            # ignore clicks and coughs
CLEANUP_INTERVAL_SECONDS = 3600
EXIT_FOR_SLEEP = 75   # heard.service restarts on this code; the restart lands after resume

DATA_DIRECTORY = Path.home() / ".local/share/heard"
DATABASE_PATH = DATA_DIRECTORY / "heard.db"
PAUSE_FLAG = DATA_DIRECTORY / "paused"
LIVE_PATH = DATA_DIRECTORY / "live.json"   # in-progress (partial) text per speaker, for `heard -f`
HEARTBEAT_PATH = DATA_DIRECTORY / "daemon.alive"   # touched every 2 s while the daemon runs (heard status, heard-ui)

THEM_SOURCE = os.environ.get("HEARD_THEM_SOURCE", "")   # empty: follow the current default output
ME_SOURCE = os.environ.get("HEARD_ME_SOURCE", "")       # empty: the default microphone
SOURCE_CHECK_SECONDS = 10.0 if IS_WINDOWS else 2.0      # the Windows check starts a Python process
NO_WINDOW = {"creationflags": subprocess.CREATE_NO_WINDOW} if IS_WINDOWS else {}   # no console flashes on Windows
MODEL_NAME = os.environ.get("HEARD_MODEL", "large-v3-turbo")
CPU_MODEL_NAME = os.environ.get("HEARD_CPU_MODEL", "small.en")   # used when there is no usable GPU
CPU_THREADS = int(os.environ.get("HEARD_CPU_THREADS", str(max(2, (os.cpu_count() or 12) // 2))))   # half the cores
RETENTION_DAYS = float(os.environ.get("HEARD_RETENTION_DAYS", "3"))
MAX_LISTEN_MINUTES = float(os.environ.get("HEARD_MAX_LISTEN_MINUTES", "180"))   # auto-pause: a forgotten switch is not a week of audio

stopping = threading.Event()
latest_partials = {}                 # speaker -> (started_at, audio so far); newest wins
partials_lock = threading.Lock()


def log(message):
    print(time.strftime("%H:%M:%S"), message, flush=True)


# --- capture back ends -------------------------------------------------------------------------------

def mac_helper():
    """heard-tap, built by macos/install.sh: next to this script, or on PATH."""
    beside = Path(__file__).resolve().parent / "heard-tap"
    helper = str(beside) if beside.exists() else shutil.which("heard-tap")
    if not helper:
        sys.exit("heard-tap not found: run macos/install.sh (it builds and installs it next to heard-daemon)")
    return helper


def query_helper(what):
    """Ask the platform helper a question (default-output / default-input); '' if it cannot answer."""
    if IS_MAC:
        command = [mac_helper(), what]
    else:
        command = [sys.executable, os.path.abspath(__file__), "tap", what]
    result = subprocess.run(command, capture_output=True, text=True, encoding="utf-8", errors="replace",
                            env={**os.environ, "PYTHONIOENCODING": "utf-8"}, **NO_WINDOW)
    return result.stdout.strip()


def default_output_monitor():
    """Where "them" is right now: every output device, mixed (Linux and Windows: "all outputs: " plus their
    names, so adding or removing one restarts the capture), or the default output device (macOS, by UID)."""
    if IS_LINUX:   # every sink, mixed (see linux_tap_all_outputs); the set changing restarts the capture
        return ALL_OUTPUTS + "; ".join(sorted(linux_sinks()))
    return query_helper("default-output")


def default_input():
    if IS_LINUX:
        return "@DEFAULT_SOURCE@"
    return query_helper("default-input")


def capture_command(speaker, source):
    if IS_MAC:
        return [mac_helper(), speaker, source]
    if IS_WINDOWS or (speaker == "them" and source.startswith(ALL_OUTPUTS)):
        return [sys.executable, os.path.abspath(__file__), "tap", speaker, source]
    return ["parec", f"--device={source}", "--raw", "--format=s16le", f"--rate={SAMPLE_RATE}",
            "--channels=1", "--latency-msec=100", f"--client-name=heard ({speaker})"]


def windows_tap(arguments):
    """`heard-daemon tap default-output|default-input|them [device]|me [device]` on Windows: the
    parec / heard-tap equivalent, run as a child process so each capture gets a fresh device list.
    "them" is the WASAPI loopback device that PyAudioWPatch exposes for every output device (the stock
    PortAudio builds, e.g. sounddevice's, have no loopback devices)."""
    import pyaudiowpatch as pyaudio

    audio = pyaudio.PyAudio()
    try:
        wasapi = audio.get_host_api_info_by_type(pyaudio.paWASAPI)
    except OSError:
        sys.exit("no WASAPI host API; Windows Vista or newer is required")
    devices = [device for device in audio.get_device_info_generator() if device["hostApi"] == wasapi["index"]]

    def loopback_of(output):
        try:
            return audio.get_wasapi_loopback_analogue_by_dict(output)
        except (LookupError, ValueError):
            sys.exit(f"no loopback device for output {output['name']!r}")

    def by_name(name):
        for device in devices:
            if device["name"] == name and device["maxInputChannels"] > 0:
                return device
        sys.exit(f"no input device named {name!r}")

    what = arguments[0] if arguments else ""
    wanted = arguments[1] if len(arguments) > 1 and arguments[1] else ""
    if what == "default-output":
        # "them" listens to every output at once, so the answer is the set of outputs: when a device
        # appears or disappears (headphones plugged in, a monitor woken up) the capture restarts with it
        names = sorted(device["name"].removesuffix(" [Loopback]") for device in audio.get_loopback_device_info_generator())
        print(ALL_OUTPUTS + "; ".join(names))
        return 0
    if what == "default-input":
        print(audio.get_default_wasapi_device(d_in=True)["name"])
        return 0
    if what == "them" and (not wanted or wanted.startswith(ALL_OUTPUTS)):
        return windows_tap_all_outputs(audio, pyaudio)
    if what == "them":
        device = by_name(wanted)
    elif what == "me":
        device = by_name(wanted) if wanted else audio.get_default_wasapi_device(d_in=True)
    else:
        sys.exit("usage: heard-daemon tap default-output | default-input | them [device] | me [device]")

    rate = int(device["defaultSampleRate"])
    channels = max(1, int(device["maxInputChannels"]))   # WASAPI shared mode wants the device's own layout
    block = int(rate * FRAME_SECONDS)
    print(f"capturing {what}: {device['name']} at {rate} Hz, {channels} ch", file=sys.stderr, flush=True)
    stream = audio.open(format=pyaudio.paFloat32, channels=channels, rate=rate, input=True,
                        input_device_index=device["index"], frames_per_buffer=block)
    out = sys.stdout.buffer
    try:
        while True:
            # a loopback stream delivers nothing while the output is silent; read() just waits
            frames = numpy.frombuffer(stream.read(block, exception_on_overflow=False), dtype=numpy.float32)
            mono = frames.reshape(-1, channels).mean(axis=1) if channels > 1 else frames
            resampled = resample_to_16k(mono, rate)
            out.write((numpy.clip(resampled, -1.0, 1.0) * 32767).astype("<i2").tobytes())
            out.flush()
    except (BrokenPipeError, OSError):
        return 0
    finally:
        stream.close()
        audio.terminate()


ALL_OUTPUTS = "all outputs: "


def mix_outputs(outputs, read_output):
    """"them" by default on Windows and Linux: every output device at once, mixed into one stream.

    Apps can send sound to any output (Zoom's own speaker setting, a browser tab on the monitor's
    speakers), not only the system default, so listen to all of them. `outputs` is [(name, handle)];
    read_output(handle, push) reads one output until it fails, calling push() with 16 kHz mono float32
    samples. Each output is read in its own thread into a buffer; the mixer writes one 30 ms frame on a
    steady clock, adding whatever each output has and silence for the rest. A silent Windows loopback
    delivers no data at all, so this also keeps the stream flowing (and utterances closing) then."""
    import collections
    import threading

    frame = int(SAMPLE_RATE * FRAME_SECONDS)
    max_buffered = SAMPLE_RATE // 2   # more than 0.5 s queued means drift or a burst: drop the oldest
    buffers, primed, lock = {}, set(), threading.Lock()

    def run(key, name, handle):
        buffer = collections.deque()

        def push(samples):
            with lock:
                buffer.extend(samples.tolist())
                while len(buffer) > max_buffered:
                    buffer.popleft()

        with lock:
            buffers[key] = buffer
        try:
            read_output(handle, push)
        except OSError as error:   # unplugged: the daemon's device check restarts us with the new set
            print(f"{name} stopped: {error}", file=sys.stderr, flush=True)
        finally:
            with lock:
                buffers.pop(key, None)

    if not outputs:
        sys.exit("no output devices to listen to")
    for key, (name, handle) in enumerate(outputs):
        threading.Thread(target=run, args=(key, name, handle), daemon=True).start()
    print("capturing them: all outputs: " + ", ".join(name for name, _ in outputs), file=sys.stderr, flush=True)

    out = sys.stdout.buffer
    next_tick = time.monotonic()
    try:
        while True:
            next_tick += FRAME_SECONDS
            time.sleep(max(0.0, next_tick - time.monotonic()))
            mixed = numpy.zeros(frame, dtype=numpy.float32)
            with lock:
                for index, buffer in buffers.items():
                    # a small jitter buffer: start draining a device only once ~90 ms is queued, so a
                    # block that arrives a moment late doesn't punch a silent hole into speech
                    if index not in primed and len(buffer) >= frame * 3:
                        primed.add(index)
                    if index not in primed:
                        continue
                    take = min(frame, len(buffer))
                    if take:
                        mixed[:take] += numpy.fromiter((buffer.popleft() for _ in range(take)), numpy.float32, take)
                    if not buffer:
                        primed.discard(index)   # the output went quiet: prime again when sound returns
            out.write((numpy.clip(mixed, -1.0, 1.0) * 32767).astype("<i2").tobytes())
            out.flush()
            if time.monotonic() - next_tick > 1.0:   # fell behind (sleep, a stall): resync, don't race
                next_tick = time.monotonic()
    except (BrokenPipeError, OSError):
        return 0


def windows_tap_all_outputs(audio, pyaudio):
    """The WASAPI loopback of every output device (PyAudioWPatch), mixed by mix_outputs()."""
    def read(device, push):
        rate = int(device["defaultSampleRate"])
        channels = max(1, int(device["maxInputChannels"]))   # WASAPI shared mode wants the device's own layout
        block = int(rate * FRAME_SECONDS)
        stream = audio.open(format=pyaudio.paFloat32, channels=channels, rate=rate, input=True,
                            input_device_index=device["index"], frames_per_buffer=block)
        try:
            while True:
                frames = numpy.frombuffer(stream.read(block, exception_on_overflow=False), dtype=numpy.float32)
                mono = frames.reshape(-1, channels).mean(axis=1) if channels > 1 else frames
                push(resample_to_16k(mono, rate))
        finally:
            stream.close()

    try:
        return mix_outputs([(device["name"], device) for device in audio.get_loopback_device_info_generator()], read)
    finally:
        audio.terminate()


def linux_sinks():
    """Every PulseAudio / PipeWire output (sink) by name."""
    result = subprocess.run(["pactl", "list", "short", "sinks"], capture_output=True, text=True)
    return [line.split("\t")[1] for line in result.stdout.splitlines() if line.count("\t") >= 1]


def linux_tap_all_outputs():
    """`heard-daemon tap them` on Linux: parec on the monitor of every sink, mixed by mix_outputs().
    Read-only like the single-sink capture: no modules loaded, no streams moved."""
    def read(sink, push):
        process = subprocess.Popen(["parec", f"--device={sink}.monitor", "--raw", "--format=s16le",
                                    f"--rate={SAMPLE_RATE}", "--channels=1", "--latency-msec=30",
                                    "--client-name=heard (them)"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        try:
            while True:
                raw = process.stdout.read(FRAME_SAMPLES * 2)
                if not raw:
                    raise OSError("parec ended")
                push(numpy.frombuffer(raw[:len(raw) // 2 * 2], dtype="<i2").astype(numpy.float32) / 32768.0)
        finally:
            process.terminate()

    return mix_outputs([(sink, sink) for sink in linux_sinks()], read)


def resample_to_16k(mono, rate):
    """Good enough for speech recognition: average whole groups of samples when the rate divides
    evenly (48 kHz → 16 kHz), linear interpolation otherwise (44.1 kHz)."""
    if rate == SAMPLE_RATE:
        return mono
    if rate % SAMPLE_RATE == 0:
        factor = rate // SAMPLE_RATE
        usable = len(mono) - len(mono) % factor
        return mono[:usable].reshape(-1, factor).mean(axis=1)
    count = int(round(len(mono) * SAMPLE_RATE / rate))
    positions = numpy.arange(count) * (rate / SAMPLE_RATE)
    return numpy.interp(positions, numpy.arange(len(mono)), mono)


# --- the daemon -----------------------------------------------------------------------------------

def preload_cuda_libraries():
    """faster-whisper (CTranslate2) dlopens cuBLAS/cuDNN; load the pip-installed copies first
    (lib/*.so on Linux, bin/*.dll on Windows)."""
    for package in ("nvidia.cublas", "nvidia.cudnn"):
        spec = importlib.util.find_spec(package)
        for root in (spec.submodule_search_locations or []) if spec else []:
            libraries = sorted(glob.glob(os.path.join(root, "lib", "lib*.so*")) +
                               glob.glob(os.path.join(root, "bin", "*.dll")))
            for library in libraries:
                try:
                    if IS_WINDOWS:
                        os.add_dll_directory(os.path.dirname(library))
                    ctypes.CDLL(library, mode=ctypes.RTLD_GLOBAL)
                except OSError:
                    pass


def open_database():
    DATA_DIRECTORY.mkdir(parents=True, exist_ok=True)
    os.chmod(DATA_DIRECTORY, 0o700)
    connection = sqlite3.connect(DATABASE_PATH, check_same_thread=False)
    connection.execute("PRAGMA journal_mode=WAL")
    connection.execute(
        "CREATE VIRTUAL TABLE IF NOT EXISTS utterances USING fts5("
        "text, speaker UNINDEXED, started_at UNINDEXED, ended_at UNINDEXED)")
    os.chmod(DATABASE_PATH, 0o600)
    return connection


def capture(speaker, resolve_source, chunks):
    """Read one source while Listening is on, cut it into utterances with a simple energy gate, queue them.

    While paused there is no capture process at all. watch_capture() ends the process when Listening is
    turned off or the default device changes (resolve_source() differs), and the loop starts over."""
    while not stopping.is_set():
        if PAUSE_FLAG.exists():
            stopping.wait(0.25)
            continue
        source = resolve_source()
        process = subprocess.Popen(capture_command(speaker, source), stdout=subprocess.PIPE,
                                   stderr=subprocess.DEVNULL, **NO_WINDOW)
        ended = {"why": None}
        threading.Thread(target=watch_capture, args=(process, source, resolve_source, ended), daemon=True).start()
        log(f"capturing {speaker} from {source or 'the default device'}")
        noise_floor = 200.0
        utterance_frames = []
        speech_frames = 0
        silent_run = 0
        started_at = None
        last_partial = 0.0
        while not stopping.is_set():
            raw = process.stdout.read(FRAME_SAMPLES * 2)
            if not raw or len(raw) < FRAME_SAMPLES * 2 or ended["why"]:
                break
            frame = numpy.frombuffer(raw, dtype=numpy.int16)
            loudness = float(numpy.sqrt(numpy.mean(frame.astype(numpy.float32) ** 2)))
            is_speech = loudness > max(noise_floor * 3.0, 300.0)
            if not is_speech:
                noise_floor = 0.95 * noise_floor + 0.05 * loudness
            if is_speech or utterance_frames:
                if started_at is None:
                    started_at = time.time()
                utterance_frames.append(frame)
                speech_frames += is_speech
                silent_run = 0 if is_speech else silent_run + 1
            duration = len(utterance_frames) * FRAME_SECONDS
            if (utterance_frames and duration >= PARTIAL_INTERVAL_SECONDS and speech_frames
                    and time.time() - last_partial >= PARTIAL_INTERVAL_SECONDS):
                last_partial = time.time()
                with partials_lock:
                    latest_partials[speaker] = (started_at, numpy.concatenate(utterance_frames).astype(numpy.float32) / 32768.0)
            if utterance_frames and (silent_run * FRAME_SECONDS >= SILENCE_TO_CLOSE_SECONDS
                                     or duration >= MAX_UTTERANCE_SECONDS):
                if speech_frames * FRAME_SECONDS >= MIN_SPEECH_SECONDS:
                    audio = numpy.concatenate(utterance_frames).astype(numpy.float32) / 32768.0
                    chunks.put((speaker, started_at, time.time(), audio))
                with partials_lock:
                    latest_partials.pop(speaker, None)
                utterance_frames, speech_frames, silent_run, started_at = [], 0, 0, None
        process.terminate()
        process.wait()
        with partials_lock:
            latest_partials.pop(speaker, None)
        if ended["why"] == "switched":
            log(f"{speaker}: device changed, following it")
        elif ended["why"] == "paused":
            log(f"{speaker}: paused, capture stopped")
        elif not stopping.is_set():
            log(f"{speaker} capture from {source or 'the default device'} ended; retrying in 5 s")
            stopping.wait(5)


def watch_capture(process, source, resolve_source, ended):
    """Beside the reader, which can block for a long time (a WASAPI loopback delivers nothing while the
    output is silent): end the capture process as soon as Listening is off, or when the device changed."""
    last_check = time.time()
    while process.poll() is None:
        if stopping.is_set() or PAUSE_FLAG.exists():
            ended["why"] = "paused"
        elif time.time() - last_check >= SOURCE_CHECK_SECONDS:
            last_check = time.time()
            if resolve_source() != source:
                ended["why"] = "switched"
        if ended["why"]:
            process.terminate()
            return
        time.sleep(0.25)


def load_model():
    """The big model on the GPU (Linux and Windows with NVIDIA CUDA); if CUDA is unusable (no GPU,
    or the driver wants a reboot after a suspend/resume fault), a small English model on the CPU so
    transcripts keep coming. macOS has no CUDA: the CPU model, or HEARD_MODEL if set."""
    from faster_whisper import WhisperModel
    if IS_MAC:
        name = os.environ.get("HEARD_MODEL", CPU_MODEL_NAME)
    else:
        try:
            preload_cuda_libraries()
            model = WhisperModel(MODEL_NAME, device="cuda", compute_type="float16")
            log(f"model {MODEL_NAME} loaded on the GPU")
            return model
        except Exception as error:
            log(f"GPU unavailable ({error}); using {CPU_MODEL_NAME} on the CPU")
            name = CPU_MODEL_NAME
    model = WhisperModel(name, device="cpu", compute_type="int8", cpu_threads=CPU_THREADS)
    log(f"model {name} loaded on the CPU ({CPU_THREADS} threads)")
    return model


def write_live(live):
    """Live captions are best effort: on Windows the replace fails while a reader has the file open."""
    temporary = LIVE_PATH.with_suffix(".tmp")
    temporary.write_text(json.dumps(live), encoding="utf-8")
    os.chmod(temporary, 0o600)
    for _ in range(10):
        try:
            os.replace(temporary, LIVE_PATH)
            return
        except PermissionError:
            time.sleep(0.02)


def transcribe(chunks, connection):
    """Finished utterances first (they go into the database); when none are waiting, refresh
    the live partial text of whoever is still talking (live.json, shown by `heard -f`)."""
    model = load_model()
    live = {}
    write_live(live)
    while not stopping.is_set():
        try:
            speaker, started_at, ended_at, audio = chunks.get(timeout=0.1)
        except queue.Empty:
            with partials_lock:
                speaker = next(iter(latest_partials), None)
                partial = latest_partials.pop(speaker, None) if speaker else None
            if partial:
                started_at, audio = partial
                segments, _ = model.transcribe(audio, language="en", beam_size=1, vad_filter=False,
                                               condition_on_previous_text=False, without_timestamps=True)
                partial_text = " ".join(segment.text.strip() for segment in segments).strip()
                if partial_text:
                    live[speaker] = {"text": partial_text, "started_at": started_at, "updated_at": time.time()}
                    write_live(live)
            continue
        segments, _ = model.transcribe(audio, language="en", beam_size=1, vad_filter=True,
                                       condition_on_previous_text=False)
        text = " ".join(segment.text.strip() for segment in segments).strip()
        if text:
            connection.execute("INSERT INTO utterances (text, speaker, started_at, ended_at) VALUES (?, ?, ?, ?)",
                               (text, speaker, started_at, ended_at))
            connection.commit()
        if live.pop(speaker, None) is not None:
            write_live(live)


def clean_up(connection):
    while not stopping.wait(CLEANUP_INTERVAL_SECONDS):
        cutoff = time.time() - RETENTION_DAYS * 86400
        connection.execute("DELETE FROM utterances WHERE CAST(started_at AS REAL) < ?", (cutoff,))
        connection.commit()


def auto_pause():
    """Pause by itself after MAX_LISTEN_MINUTES of continuous capture, so a switch left on does not
    quietly transcribe the rest of the day. Turning Listening on again restarts the clock."""
    listening_since = None
    while not stopping.wait(10):
        if PAUSE_FLAG.exists():
            listening_since = None
        elif listening_since is None:
            listening_since = time.time()
        elif time.time() - listening_since > MAX_LISTEN_MINUTES * 60:
            PAUSE_FLAG.touch()
            listening_since = None
            log(f"paused automatically after {MAX_LISTEN_MINUTES:.0f} minutes of listening")


def heartbeat():
    while not stopping.is_set():
        try:
            HEARTBEAT_PATH.touch()
        except OSError:
            pass
        stopping.wait(2)


def exit_before_sleep():
    """Linux only. A CUDA context kept across suspend/resume faulted the GPU (NVIDIA Xid 31 → "reboot
    required"). So hold a logind delay lock, and when sleep is announced, exit: the lock is released
    with the process, the machine sleeps, and systemd starts a fresh process (fresh CUDA context) after
    resume. On macOS and Windows a capture child that fails (sleep, an unplugged headset) is restarted
    by capture() on whatever the default device is then."""
    inhibitor = subprocess.Popen(
        ["systemd-inhibit", "--what=sleep", "--mode=delay", "--who=heard",
         "--why=release the GPU before suspend", "sleep", "infinity"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    monitor = subprocess.Popen(
        ["gdbus", "monitor", "--system", "--dest", "org.freedesktop.login1",
         "--object-path", "/org/freedesktop/login1"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    for line in monitor.stdout:
        if "PrepareForSleep" in line and "true" in line:
            log("system is going to sleep: exiting to release the GPU")
            stopping.set()
            inhibitor.terminate()
            os._exit(EXIT_FOR_SLEEP)


def single_instance(name):
    """An exclusive lock held for the life of the process; None if another instance holds it. On Windows,
    stopping a Scheduled Task ends only its launcher, so an earlier daemon can still be running."""
    DATA_DIRECTORY.mkdir(parents=True, exist_ok=True)
    handle = open(DATA_DIRECTORY / f"{name}.lock", "a+")
    try:
        if IS_WINDOWS:
            import msvcrt
            handle.seek(0)
            msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
        else:
            import fcntl
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        return None
    return handle


def main():
    if IS_WINDOWS:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")   # device names in the log are not always ASCII
        sys.stderr.reconfigure(encoding="utf-8", errors="replace")
        if sys.argv[1:2] == ["tap"]:
            return windows_tap(sys.argv[2:])
    if IS_LINUX and sys.argv[1:3] == ["tap", "them"]:
        return linux_tap_all_outputs()
    lock = single_instance("daemon")
    if lock is None:
        log("another heard-daemon is already running; exiting")
        return 0
    connection = open_database()
    if os.environ.get("HEARD_START_LISTENING"):
        PAUSE_FLAG.unlink(missing_ok=True)
    else:   # conservative default: nothing is captured until `heard resume` or the overlay's Listening switch
        PAUSE_FLAG.touch()
        log("started paused: `heard resume` or the overlay's Listening switch turns capture on")
    chunks = queue.Queue(maxsize=200)
    signal.signal(signal.SIGTERM, lambda *_: stopping.set())
    resolve_them = (lambda: THEM_SOURCE) if THEM_SOURCE else default_output_monitor
    resolve_me = (lambda: ME_SOURCE) if ME_SOURCE else default_input
    workers = [
        threading.Thread(target=capture, args=("them", resolve_them, chunks), daemon=True),
        threading.Thread(target=capture, args=("me", resolve_me, chunks), daemon=True),
        threading.Thread(target=clean_up, args=(connection,), daemon=True),
        threading.Thread(target=auto_pause, daemon=True),
        threading.Thread(target=heartbeat, daemon=True),
    ]
    if IS_LINUX:
        workers.append(threading.Thread(target=exit_before_sleep, daemon=True))
    for worker in workers:
        worker.start()
    try:
        transcribe(chunks, connection)
    except KeyboardInterrupt:
        stopping.set()
    return 0


if __name__ == "__main__":
    sys.exit(main())
